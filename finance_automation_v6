// ===================== DATA VALIDATION & REPAIR =====================

function validateDataIntegrity() {
  try {
    const ss = _ss();
    const issues = [];
    
    // Validate transactions
    const mainSheet = ss.getSheetByName(SHEET_NAMES.MAIN);
    if (mainSheet && mainSheet.getLastRow() > 1) {
      const data = mainSheet.getRange(2, 1, mainSheet.getLastRow() - 1, Object.keys(COLUMNS.TRANSACTIONS).length).getValues();
      
      data.forEach((row, index) => {
        const rowNum = index + 2;
        
        // Check for missing essential data
        if (!row[COLUMNS.TRANSACTIONS.DATE - 1] || isNaN(new Date(row[COLUMNS.TRANSACTIONS.DATE - 1]).getTime())) {
          issues.push(`Row ${rowNum}: Invalid or missing date`);
        }
        
        if (isNaN(parseFloat(row[COLUMNS.TRANSACTIONS.AMOUNT - 1]))) {
          issues.push(`Row ${rowNum}: Invalid or missing amount`);
        }
        
        // Check for phantom "Cash" accounts
        const fromAccount = _normalize(row[COLUMNS.TRANSACTIONS.FROM - 1]);
        const toAccount = _normalize(row[COLUMNS.TRANSACTIONS.TO - 1]);
        
        if (_lc(fromAccount) === 'cash' || _lc(toAccount) === 'cash') {
          issues.push(`Row ${rowNum}: Contains phantom "Cash" account`);
        }
        
        // Check for missing fingerprints on newer transactions
        if (!row[COLUMNS.TRANSACTIONS.FINGERPRINT - 1] && new Date(row[COLUMNS.TRANSACTIONS.DATE - 1]) > new Date('2024-01-01')) {
          issues.push(`Row ${rowNum}: Missing transaction fingerprint`);
        }
      });
    }
    
    // Validate accounts
    const accountsSheet = ss.getSheetByName(SHEET_NAMES.ACCOUNTS);
    if (accountsSheet && accountsSheet.getLastRow() > 1) {
      const accountData = accountsSheet.getRange(2, 1, accountsSheet.getLastRow() - 1, Object.keys(COLUMNS.ACCOUNTS).length).getValues();
      
      accountData.forEach((row, index) => {
        const rowNum = index + 2;
        const accountName = _normalize(row[COLUMNS.ACCOUNTS.NAME - 1]);
        
        // Check for phantom accounts
        if (_lc(accountName) === 'cash' || !accountName) {
          issues.push(`Account row ${rowNum}: Phantom or empty account name`);
        }
        
        // Check for invalid balances
        const balance = row[COLUMNS.ACCOUNTS.BALANCE - 1];
        if (isNaN(parseFloat(balance))) {
          issues.push(`Account row ${rowNum}: Invalid balance for ${accountName}`);
        }
      });
    }
    
    // Validate holdings
    const holdingsSheet = ss.getSheetByName(SHEET_NAMES.HOLDINGS);
    if (holdingsSheet && holdingsSheet.getLastRow() > 1) {
      const holdingsData = holdingsSheet.getRange(2, 1, holdingsSheet.getLastRow() - 1, Object.keys(COLUMNS.HOLDINGS).length).getValues();
      
      holdingsData.forEach((row, index) => {
        const rowNum = index + 2;
        const shares = parseFloat(row[COLUMNS.HOLDINGS.SHARES - 1] || 0);
        const price = parseFloat(row[COLUMNS.HOLDINGS.PRICE - 1] || 0);
        const value = parseFloat(row[COLUMNS.HOLDINGS.VALUE - 1] || 0);
        
        // Check calculation consistency
        if (shares && price && Math.abs((shares * price) - value) > 0.01) {
          issues.push(`Holdings row ${rowNum}: Value calculation mismatch`);
        }
        
        // Check for zero or negative shares (unusual)
        if (shares <= 0) {
          issues.push(`Holdings row ${rowNum}: Zero or negative shares`);
        }
      });
    }
    
    const message = issues.length === 0 ? 
      '✅ Data integrity validation passed - no issues found!' :
      `⚠️ Found ${issues.length} data integrity issues:\n\n${issues.slice(0, 15).join('\n')}${issues.length > 15 ? '\n\n...and more. Check audit logs for full list.' : ''}`;
    
    if (issues.length > 0) {
      _logWarning('Data integrity issues found', { issues: issues });
    } else {
      _logInfo('Data integrity validation passed');
    }
    
    SpreadsheetApp.getUi().alert(message);
    
  } catch (error) {
    _logError('Data integrity validation failed', error);
    SpreadsheetApp.getUi().alert('❌ Data integrity validation failed. See logs for details.');
  }
}

function repairCommonIssues() {
  try {
    const ss = _ss();
    let repairsCount = 0;
    
    // Repair missing fingerprints
    const mainSheet = ss.getSheetByName(SHEET_NAMES.MAIN);
    if (mainSheet && mainSheet.getLastRow() > 1) {
      const data = mainSheet.getRange(2, 1, mainSheet.getLastRow() - 1, Object.keys(COLUMNS.TRANSACTIONS).length).getValues();
      
      data.forEach((row, index) => {
        const rowNum = index + 2;
        
        if (!row[COLUMNS.TRANSACTIONS.FINGERPRINT - 1]) {
          const transaction = {
            date: row[COLUMNS.TRANSACTIONS.DATE - 1],
            amount: row[COLUMNS.TRANSACTIONS.AMOUNT - 1],
            fromAccount: row[COLUMNS.TRANSACTIONS.FROM - 1],
            toAccount: row[COLUMNS.TRANSACTIONS.TO - 1]
          };
          
          const fingerprint = _generateFingerprint(transaction);
          mainSheet.getRange(rowNum, COLUMNS.TRANSACTIONS.FINGERPRINT).setValue(fingerprint);
          repairsCount++;
        }
      });
    }
    
    // Remove phantom "Cash" accounts
    const accountsSheet = ss.getSheetByName(SHEET_NAMES.ACCOUNTS);
    if (accountsSheet && accountsSheet.getLastRow() > 1) {
      const data = accountsSheet.getDataRange().getValues();
      
      for (let i = data.length - 1; i >= 1; i--) {
        const accountName = _normalize(data[i][COLUMNS.ACCOUNTS.NAME - 1]);
        if (_lc(accountName) === 'cash' || !accountName) {
          accountsSheet.deleteRow(i + 1);
          repairsCount++;
        }
      }
    }
    
    SpreadsheetApp.getUi().alert(`✅ Repair completed!\n\n${repairsCount} issues fixed.`);
    _logInfo(`Data repair completed: ${repairsCount} issues fixed`);
    
  } catch (error) {
    _logError('Failed to repair data issues', error);
    SpreadsheetApp.getUi().alert('❌ Data repair failed. Check logs.');
  }
}

