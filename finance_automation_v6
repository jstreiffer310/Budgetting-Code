// ===================== ACCOUNT MANAGEMENT =====================

function _normalizeAccountName(name) {
  if (!name) return '';
  
  const normalized = _normalize(name);
  const lowered = _lc(normalized);
  
  // CRITICAL: Check for "cash" and return empty string to prevent phantom accounts
  if (lowered === 'cash') return '';
  
  // Check aliases first
  for (const [alias, canonical] of Object.entries(ACCOUNT_ALIASES)) {
    if (lowered.includes(alias)) {
      return canonical || ''; // Return empty string if canonical is empty
    }
  }
  
  // Exact match with known accounts
  const exactMatch = MY_ACCOUNTS.find(acc => _lc(acc) === lowered);
  if (exactMatch) return exactMatch;
  
  // Partial match with known accounts
  const partialMatch = MY_ACCOUNTS.find(acc => 
    lowered.includes(_lc(acc)) || _lc(acc).includes(lowered)
  );
  
  return partialMatch || normalized;
}

function _isInternalAccount(name) {
  if (!name) return false;
  const normalized = _normalizeAccountName(name);
  return normalized && MY_ACCOUNTS.some(acc => _lc(acc) === _lc(normalized));
}

function _findAccountRow(accountsSheet, accountName) {
  if (!accountsSheet || !accountName) return -1;
  
  const data = accountsSheet.getDataRange().getValues();
  
  // Exact match first
  for (let i = 1; i < data.length; i++) {
    if (_lc(data[i][COLUMNS.ACCOUNTS.NAME - 1]) === _lc(accountName)) {
      return i + 1;
    }
  }
  
  return -1;
}

function _ensureAccountExists(accountsSheet, accountName) {
  if (!accountName || !accountsSheet) return -1;
  
  const normalized = _normalizeAccountName(accountName);
  if (!normalized) return -1; // Prevents creating phantom accounts
  
  let row = _findAccountRow(accountsSheet, normalized);
  
  if (row === -1) {
    // Create new account
    accountsSheet.appendRow([normalized, 0, new Date(), 'Auto-Created']);
    row = accountsSheet.getLastRow();
    _logInfo(`Created new account: ${normalized}`);
  }
  
  return row;
}

// ===================== TRANSACTION FINGERPRINTING & DEDUPLICATION =====================

function _generateFingerprint(transaction) {
  const date = transaction.date ? new Date(transaction.date) : new Date();
  const dateStr = date.toISOString().slice(0, 10);
  const amountStr = Math.abs(parseFloat(transaction.amount || 0)).toFixed(2);
  const fromStr = _normalize(transaction.fromAccount || '').slice(0, 30);
  const toStr = _normalize(transaction.toAccount || '').slice(0, 30);
  
  const key = [dateStr, amountStr, fromStr, toStr].join('|');
  return Utilities.base64Encode(
    Utilities.computeDigest(Utilities.DigestAlgorithm.MD5, key)
  ).slice(0, 12);
}

function _isDuplicateTransaction(transaction, mainSheet) {
  if (!mainSheet || mainSheet.getLastRow() < 2) return false;
  
  const data = mainSheet.getRange(2, 1, mainSheet.getLastRow() - 1, Object.keys(COLUMNS.TRANSACTIONS).length).getValues();
  const newFingerprint = _generateFingerprint(transaction);
  
  return data.some(row => {
    // Check by email ID first (most reliable)
    if (transaction.emailId && _normalize(row[COLUMNS.TRANSACTIONS.EMAIL_ID - 1]) === transaction.emailId) {
      return true;
    }
    
    // Check by fingerprint
    if (row[COLUMNS.TRANSACTIONS.FINGERPRINT - 1] === newFingerprint) {
      return true;
    }
    
    // Legacy check for transactions without fingerprints
    const existingDate = row[COLUMNS.TRANSACTIONS.DATE - 1] ? 
      new Date(row[COLUMNS.TRANSACTIONS.DATE - 1]).toDateString() : '';
    const transactionDate = transaction.date ? 
      new Date(transaction.date).toDateString() : '';
    const existingAmount = parseFloat(row[COLUMNS.TRANSACTIONS.AMOUNT - 1] || 0);
    const transactionAmount = parseFloat(transaction.amount || 0);
    
    return existingDate === transactionDate &&
           Math.abs(existingAmount - transactionAmount) < CONFIG.AMOUNT_TOLERANCE &&
           _normalize(row[COLUMNS.TRANSACTIONS.FROM - 1]) === _normalize(transaction.fromAccount) &&
           _normalize(row[COLUMNS.TRANSACTIONS.TO - 1]) === _normalize(transaction.toAccount);
  });
}

// ===================== EMAIL PARSING FRAMEWORK =====================

function _extractAmount(text, customRegex = null) {
  const regex = customRegex || /\$([0-9,]+\.[0-9]{2})/i;
  const match = text.match(regex);
  return match ? parseFloat(match[1].replace(/,/g, '')) : null;
}

function _extractText(text, regex) {
  const match = text.match(regex);
  return match ? match[1].trim() : null;
}

function _htmlToText(html) {
  try {
    return html.replace(/<[^>]+>/g, ' ').replace(/\s+/g, ' ').trim();
  } catch (error) {
    return '';
  }
}

// ===================== CIBC EMAIL PARSER =====================

function _parseCibcEmail(message, subject, body, accountsSheet) {
  const subjectLower = _lc(subject);
  const bodyLower = _lc(body);
  
  // PAYMENT detection - Credit to card account (subject line priority)
  const paymentKeywords = [
    'payment', 'payment received', 'new payment to your credit card',
    'payment has been applied', 'credit card payment', 'payment processed'
  ];
  
  if (paymentKeywords.some(keyword => subjectLower.includes(keyword))) {
    const amount = _extractAmount(body) || _extractAmount(subject);
    if (!amount) return null;
    
    // Determine target card account
    let targetAccount = 'CIBC Aventura'; // Default
    
    if (/aventura/i.test(subject + body)) {
      targetAccount = 'CIBC Aventura';
    } else if (/dividend/i.test(subject + body)) {
      targetAccount = 'CIBC Dividend';
    } else if (accountsSheet) {
      // Choose card with most negative balance (most debt)
      targetAccount = _chooseMostNegativeCibcCard(accountsSheet) || 'CIBC Aventura';
    }
    
    return {
      date: message.getDate(),
      amount: amount,
      direction: 'IN',
      fromAccount: 'External Payment',
      toAccount: targetAccount,
      bank: 'CIBC Card Payment',
      emailId: message.getId(),
      type: 'Card Payment',
      notes: `Payment to ${targetAccount}`
    };
  }
  
  // PURCHASE detection - Debit from card account
  const purchaseKeywords = ['purchase', 'charge', 'authorization', 'transaction'];
  
  if (purchaseKeywords.some(keyword => subjectLower.includes(keyword)) ||
      /purchase of|your card.*was charged|card ending in/i.test(bodyLower)) {
    
    const amount = _extractAmount(body) || _extractAmount(subject);
    if (!amount) return null;
    
    // Determine card account
    let cardAccount = 'CIBC Aventura'; // Default
    
    if (/aventura/i.test(subject + body)) {
      cardAccount = 'CIBC Aventura';
    } else if (/dividend/i.test(subject + body)) {
      cardAccount = 'CIBC Dividend';
    }
    
    // Extract merchant name with multiple fallback patterns
    const merchant = _extractText(body, /at\s+([A-Z0-9 \._\-&']+)\s+was/i) ||
                     _extractText(body, /merchant[:\s]*([^\n\r]+)/i) ||
                     _extractText(body, /for\s+\$[\d,]+\.[\d]{2}\s+at\s+([^.]+)\./i) ||
                     'Merchant';
    
    return {
      date: message.getDate(),
      amount: -Math.abs(amount), // Negative for expenses
      direction: 'OUT',
      fromAccount: cardAccount,
      toAccount: merchant,
      bank: `${cardAccount} Purchase`,
      emailId: message.getId(),
      type: 'Card Purchase',
      notes: `Purchase at ${merchant}`
    };
  }
  
  return null;
}

function _chooseMostNegativeCibcCard(accountsSheet) {
  if (!accountsSheet || accountsSheet.getLastRow() < 2) return null;
  
  const data = accountsSheet.getDataRange().getValues();
  let mostNegativeCard = null;
  let mostNegativeBalance = 0;
  
  for (let i = 1; i < data.length; i++) {
    const accountName = _normalize(data[i][COLUMNS.ACCOUNTS.NAME - 1]);
    if (!/^CIBC\s+(Aventura|Dividend)/i.test(accountName)) continue;
    
    const balance = parseFloat(data[i][COLUMNS.ACCOUNTS.BALANCE - 1] || 0);
    if (mostNegativeCard === null || balance < mostNegativeBalance) {
      mostNegativeCard = accountName;
      mostNegativeBalance = balance;
    }
  }
  
  return mostNegativeCard;
}

// ===================== PC FINANCIAL EMAIL PARSER =====================

function _parsePcFinancialEmail(message, subject, body) {
  const subjectLower = _lc(subject);
  const bodyLower = _lc(body);
  
  // Purchase notice
  if (subjectLower.includes('purchase notice') || /purchase amount/i.test(bodyLower)) {
    const amount = _extractAmount(body, /purchase amount[:\s]*\$([0-9,]+\.[0-9]{2})/i) ||
                   _extractAmount(body);
    if (!amount) return null;
    
    const merchant = _extractText(body, /merchant[:\s]*([^\n\r]+)/i) ||
                     _extractText(body, /at\s+([A-Z0-9 \._\-&']+)/i) ||
                     'Merchant';
    
    // Check if this is a Wealthsimple deposit (should be staged)
    if (/wealthsimple/i.test(merchant)) {
      return {
        date: message.getDate(),
        amount: -Math.abs(amount),
        direction: 'OUT',
        fromAccount: 'PC Financial',
        toAccount: 'Pending Wealthsimple',
        bank: 'PC Financial Purchase',
        emailId: message.getId(),
        type: 'Transfer',
        shouldStage: true
      };
    }
    
    return {
      date: message.getDate(),
      amount: -Math.abs(amount),
      direction: 'OUT',
      fromAccount: 'PC Financial',
      toAccount: merchant,
      bank: 'PC Financial Purchase',
      emailId: message.getId(),
      type: 'Purchase',
      notes: `Purchase at ${merchant}`
    };
  }
  
  // E-transfer sent
  if (subjectLower.includes('transfer to') || /e-transfer/i.test(bodyLower)) {
    const amount = _extractAmount(subject) || _extractAmount(body);
    if (!amount) return null;
    
    const recipient = _extractText(subject, /transfer to\s+(.+?)\s+has been/i) ||
                     _extractText(body, /transfer to\s+(.+?)\s+has been/i) ||
                     'External Recipient';
    
    // Check if this is an internal transfer
    const normalizedRecipient = _normalizeAccountName(recipient);
    const isInternal = _isInternalAccount(normalizedRecipient);
    
    return {
      date: message.getDate(),
      amount: -Math.abs(amount),
      direction: 'OUT',
      fromAccount: 'PC Financial',
      toAccount: isInternal ? normalizedRecipient : `External to ${recipient}`,
      bank: 'PC Financial e-Transfer',
      emailId: message.getId(),
      type: isInternal ? 'Internal Transfer' : 'External Transfer',
      shouldStage: isInternal
    };
  }
  
  return null;
}

// ===================== INTERAC EMAIL PARSER =====================

function _parseInteracEmail(message, subject, body) {
  const amount = _extractAmount(body, /sent you \$([0-9,]+\.[0-9]{2})/i) ||
                 _extractAmount(body, /amount[:\s]*\$([0-9,]+\.[0-9]{2})/i);
  
  if (!amount) return null;
  
  const sender = _extractText(body, /([A-Za-z0-9 .'-]+) sent you \$/i) || 'Interac Sender';
  
  return {
    date: message.getDate(),
    amount: amount,
    direction: 'IN',
    fromAccount: `e-Transfer from ${sender}`,
    toAccount: 'PC Financial', // Assume default deposit account
    bank: 'Interac Deposit',
    emailId: message.getId(),
    type: 'Interac',
    notes: `Received from ${sender}`
  };
}

// ===================== WEALTHSIMPLE EMAIL PARSER =====================

function _parseWealthsimpleEmail(message, subject, body) {
  const subjectLower = _lc(subject);
  const bodyLower = _lc(body);
  
  // Deposit confirmation
  if (subjectLower.includes('deposit') || /added money|deposit.*confirmed/i.test(bodyLower)) {
    const amount = _extractAmount(body, /amount[:\s]*\$([0-9,]+\.[0-9]{2})/i);
    if (!amount) return null;
    
    // Determine target account
    const accountInfo = _extractText(body, /to[:\s]*([\s\S]*?)\s*sometimes/i) || '';
    let targetAccount = 'Wealthsimple Cash'; // Default
    
    if (/rrsp/i.test(accountInfo)) {
      targetAccount = 'Wealthsimple RRSP';
    } else if (/crypto/i.test(accountInfo)) {
      targetAccount = 'Wealthsimple Crypto';
    }
    
    return {
      date: message.getDate(),
      amount: amount,
      direction: 'IN',
      fromAccount: 'PC Financial',
      toAccount: targetAccount,
      bank: 'Wealthsimple Deposit',
      emailId: message.getId(),
      type: 'Deposit',
      shouldPair: true
    };
  }
  
  // Trade execution
  if (subjectLower.includes('order has been filled') || /shares of/i.test(bodyLower)) {
    const tradeMatch = body.match(/(\d+[\d.,]*)\s+shares\s+of\s+([A-Z\.\-]+)[\s\S]+?total cost[:\s]*\$([0-9,]+\.[0-9]+)/i);
    
    if (!tradeMatch) return null;
    
    const shares = parseFloat(tradeMatch[1].replace(/,/g, ''));
    const ticker = tradeMatch[2].trim();
    const cost = parseFloat(tradeMatch[3].replace(/,/g, ''));
    
    // Determine account
    const accountInfo = _extractText(body, /account[:\s]*([\s\S]*?)\s*time:/i) || '';
    let targetAccount = 'Wealthsimple Cash'; // Default
    
    if (/rrsp/i.test(accountInfo)) {
      targetAccount = 'Wealthsimple RRSP';
    } else if (/crypto/i.test(accountInfo)) {
      targetAccount = 'Wealthsimple Crypto';
    }
    
    // Update holdings (will be implemented in holdings management section)
    _updateHoldingsQuantity(targetAccount, ticker, shares);
    
    return {
      date: message.getDate(),
      amount: -cost, // Negative because it's spending cash to buy securities
      direction: 'TRADE',
      fromAccount: targetAccount,
      toAccount: targetAccount, // Same account, different asset
      bank: 'Wealthsimple Trade',
      emailId: message.getId(),
      type: 'Trade',
      notes: `Bought ${shares} shares of ${ticker}`,
      tradeInfo: { ticker, shares, cost }
    };
  }
  
  return null;
}

// ===================== EMAIL PROCESSING ENGINE =====================

function _processNewEmails() {
  try {
    const ss = _ss();
    _ensureSheetsAndHeaders();
    
    const mainSheet = ss.getSheetByName(SHEET_NAMES.MAIN);
    const stagingSheet = ss.getSheetByName(SHEET_NAMES.STAGING);
    const accountsSheet = ss.getSheetByName(SHEET_NAMES.ACCOUNTS);
    
    // Get existing email IDs to prevent duplicates
    const existingIds = new Set();
    
    if (mainSheet.getLastRow() > 1) {
      const mainIds = mainSheet.getRange(2, COLUMNS.TRANSACTIONS.EMAIL_ID, mainSheet.getLastRow() - 1, 1)
        .getValues()
        .flat()
        .filter(id => id);
      mainIds.forEach(id => existingIds.add(id));
    }
    
    if (stagingSheet.getLastRow() > 1) {
      const stagingIds = stagingSheet.getRange(2, COLUMNS.STAGING.EMAIL_ID, stagingSheet.getLastRow() - 1, 1)
        .getValues()
        .flat()
        .filter(id => id);
      stagingIds.forEach(id => existingIds.add(id));
    }
    
    // Search for recent banking emails
    const searchQuery = `label:${CONFIG.GMAIL_LABEL} ${CONFIG.GMAIL_LOOKBACK}`;
    const threads = GmailApp.search(searchQuery);
    let processedCount = 0;
    let stagedCount = 0;
    
    _logInfo(`Processing ${threads.length} email threads`);
    
    threads.forEach(thread => {
      thread.getMessages().forEach(message => {
        try {
          const emailId = message.getId();
          if (existingIds.has(emailId)) return;
          
          const from = _lc(message.getFrom() || '');
          const subject = message.getSubject() || '';
          const plainBody = message.getPlainBody() || '';
          const htmlBody = _htmlToText(message.getBody() || '');
          const body = plainBody + '\n' + htmlBody;
          
          let transaction = null;
          
          // Parse based on sender
          if (from.includes('cibc')) {
            transaction = _parseCibcEmail(message, subject, body, accountsSheet);
          } else if (from.includes('pcfinancial')) {
            transaction = _parsePcFinancialEmail(message, subject, body);
          } else if (from.includes('payments.interac')) {
            transaction = _parseInteracEmail(message, subject, body);
          } else if (from.includes('wealthsimple')) {
            transaction = _parseWealthsimpleEmail(message, subject, body);
          }
          
          if (!transaction) return;
          
          // Normalize account names
          transaction.fromAccount = _normalizeAccountName(transaction.fromAccount || '');
          transaction.toAccount = _normalizeAccountName(transaction.toAccount || '');
          
          // Add fingerprint
          transaction.fingerprint = _generateFingerprint(transaction);
          
          // Determine processing path
          if (transaction.shouldStage || transaction.shouldPair) {
            _stageTransaction(transaction, stagingSheet);
            stagedCount++;
          } else {
            _commitTransaction(transaction, mainSheet, accountsSheet);
            processedCount++;
          }
          
          _logInfo(`Processed email: ${transaction.type}`, {
            emailId: transaction.emailId,
            amount: transaction.amount,
            staged: transaction.shouldStage || transaction.shouldPair
          });
          
        } catch (error) {
          _logError(`Failed to process email ${message.getId()}`, error);
        }
      });
    });
    
    _logInfo(`Email processing completed`, {
      processed: processedCount,
      staged: stagedCount,
      total: processedCount + stagedCount
    });
    
  } catch (error) {
    _logError('Failed to process new emails', error);
    throw error;
  }
}

// ===================== TRANSACTION MANAGEMENT =====================

function _stageTransaction(transaction, stagingSheet) {
  try {
    const row = [
      transaction.date || new Date(),
      transaction.amount || 0,
      transaction.fromAccount || '',
      transaction.toAccount || '',
      transaction.bank || '',
      transaction.emailId || '',
      new Date(), // Staged at
      transaction.direction || '',
      'Staged',
      transaction.fingerprint || ''
    ];
    
    stagingSheet.appendRow(row);
    
    _logInfo(`Staged transaction: ${transaction.emailId}`, {
      amount: transaction.amount,
      from: transaction.fromAccount,
      to: transaction.toAccount
    });
    
  } catch (error) {
    _logError('Failed to stage transaction', error, { transaction });
  }
}

function _commitTransaction(transaction, mainSheet, accountsSheet) {
  try {
    // Check for duplicates
    if (_isDuplicateTransaction(transaction, mainSheet)) {
      _logWarning(`Skipping duplicate transaction: ${transaction.emailId}`);
      return;
    }
    
    // Prepare transaction row with proper amount handling
    const amount = transaction.amount || 0;
    
    const row = [
      transaction.date || new Date(),
      amount,
      transaction.fromAccount || '',
      transaction.toAccount || '',
      transaction.bank || '',
      transaction.notes || '',
      transaction.emailId || `AUTO-${Date.now()}`,
      transaction.category || '',
      transaction.type || '',
      transaction.fingerprint || _generateFingerprint(transaction)
    ];
    
    mainSheet.appendRow(row);
    
    // Update account balances
    _updateAccountBalances(transaction, accountsSheet);
    
    _logInfo(`Committed transaction: ${transaction.emailId}`, {
      amount: transaction.amount,
      from: transaction.fromAccount,
      to: transaction.toAccount,
      type: transaction.type
    });
    
  } catch (error) {
    _logError('Failed to commit transaction', error, { transaction });
  }
}

function _updateAccountBalances(transaction, accountsSheet) {
  try {
    const amount = parseFloat(transaction.amount || 0);
    const fromAccount = transaction.fromAccount;
    const toAccount = transaction.toAccount;
    
    // Update FROM account (debit)
    if (fromAccount && _isInternalAccount(fromAccount)) {
      const fromRow = _ensureAccountExists(accountsSheet, fromAccount);
      if (fromRow > 0) {
        const currentBalance = parseFloat(accountsSheet.getRange(fromRow, COLUMNS.ACCOUNTS.BALANCE).getValue() || 0);
        const newBalance = currentBalance + amount; // amount is already negative for outgoing
        
        accountsSheet.getRange(fromRow, COLUMNS.ACCOUNTS.BALANCE).setValue(newBalance);
        accountsSheet.getRange(fromRow, COLUMNS.ACCOUNTS.LAST_UPDATED).setValue(new Date());
        
        _logInfo(`Updated ${fromAccount} balance: ${currentBalance.toFixed(2)} → ${newBalance.toFixed(2)}`);
      }
    }
    
    // Update TO account (credit)
    if (toAccount && _isInternalAccount(toAccount) && toAccount !== fromAccount) {
      const toRow = _ensureAccountExists(accountsSheet, toAccount);
      if (toRow > 0) {
        const currentBalance = parseFloat(accountsSheet.getRange(toRow, COLUMNS.ACCOUNTS.BALANCE).getValue() || 0);
        const newBalance = currentBalance + Math.abs(amount); // Always positive for incoming
        
        accountsSheet.getRange(toRow, COLUMNS.ACCOUNTS.BALANCE).setValue(newBalance);
        accountsSheet.getRange(toRow, COLUMNS.ACCOUNTS.LAST_UPDATED).setValue(new Date());
        
        _logInfo(`Updated ${toAccount} balance: ${currentBalance.toFixed(2)} → ${newBalance.toFixed(2)}`);
      }
    }
    
  } catch (error) {
    _logError('Failed to update account balances', error, { transaction });
  }
}

// ===================== STAGING & PAIRING SYSTEM =====================

function _pairStagedTransfers() {
  try {
    const ss = _ss();
    const stagingSheet = ss.getSheetByName(SHEET_NAMES.STAGING);
    const mainSheet = ss.getSheetByName(SHEET_NAMES.MAIN);
    const accountsSheet = ss.getSheetByName(SHEET_NAMES.ACCOUNTS);
    
    if (!stagingSheet || stagingSheet.getLastRow() < 2) {
      _logInfo('No staged transactions to pair');
      return;
    }
    
    const data = stagingSheet.getRange(2, 1, stagingSheet.getLastRow() - 1, Object.keys(COLUMNS.STAGING).length).getValues();
    const paired = new Set();
    let pairCount = 0;
    
    for (let i = 0; i < data.length; i++) {
      if (paired.has(i)) continue;
      
      const txA = {
        index: i,
        date: new Date(data[i][COLUMNS.STAGING.DATE - 1]),
        amount: parseFloat(data[i][COLUMNS.STAGING.AMOUNT - 1] || 0),
        fromAccount: data[i][COLUMNS.STAGING.FROM - 1],
        toAccount: data[i][COLUMNS.STAGING.TO - 1],
        bank: data[i][COLUMNS.STAGING.BANK - 1],
        emailId: data[i][COLUMNS.STAGING.EMAIL_ID - 1],
        direction: data[i][COLUMNS.STAGING.DIRECTION - 1],
        fingerprint: data[i][COLUMNS.STAGING.FINGERPRINT - 1]
      };
      
      // Look for matching transaction
      for (let j = i + 1; j < data.length; j++) {
        if (paired.has(j)) continue;
        
        const txB = {
          index: j,
          date: new Date(data[j][COLUMNS.STAGING.DATE - 1]),
          amount: parseFloat(data[j][COLUMNS.STAGING.AMOUNT - 1] || 0),
          fromAccount: data[j][COLUMNS.STAGING.FROM - 1],
          toAccount: data[j][COLUMNS.STAGING.TO - 1],
          bank: data[j][COLUMNS.STAGING.BANK - 1],
          emailId: data[j][COLUMNS.STAGING.EMAIL_ID - 1],
          direction: data[j][COLUMNS.STAGING.DIRECTION - 1],
          fingerprint: data[j][COLUMNS.STAGING.FINGERPRINT - 1]
        };
        
        // Check if transactions can be paired
        if (_canPairTransactions(txA, txB)) {
          // Create paired transfer
          const pairedTransaction = _createPairedTransaction(txA, txB);
          _commitTransaction(pairedTransaction, mainSheet, accountsSheet);
          
          paired.add(i);
          paired.add(j);
          pairCount++;
          
          _logInfo(`Paired transactions: ${txA.emailId} + ${txB.emailId}`, {
            amount: pairedTransaction.amount,
            from: pairedTransaction.fromAccount,
            to: pairedTransaction.toAccount
          });
          break;
        }
      }
    }
    
    // Remove paired transactions from staging (in reverse order to maintain indices)
    const rowsToDelete = Array.from(paired).sort((a, b) => b - a);
    rowsToDelete.forEach(index => {
      stagingSheet.deleteRow(index + 2);
    });
    
    _logInfo(`Pairing completed: ${pairCount} pairs created`);
    
  } catch (error) {
    _logError('Failed to pair staged transfers', error);
  }
}

function _canPairTransactions(txA, txB) {
  // Check amount tolerance
  if (Math.abs(Math.abs(txA.amount) - Math.abs(txB.amount)) > CONFIG.AMOUNT_TOLERANCE) {
    return false;
  }
  
  // Check time window
  if (Math.abs(txA.date - txB.date) > CONFIG.PAIRING_WINDOW_MS) {
    return false;
  }
  
  // Check for complementary directions (one IN, one OUT)
  if (txA.direction === txB.direction) {
    return false;
  }
  
  // Check for account overlap (at least one account should match)
  const txAAccounts = [_lc(txA.fromAccount), _lc(txA.toAccount)];
  const txBAccounts = [_lc(txB.fromAccount), _lc(txB.toAccount)];
  
  const hasAccountOverlap = txAAccounts.some(acc => 
    acc && txBAccounts.some(otherAcc => otherAcc && acc.includes(otherAcc))
  );
  
  return hasAccountOverlap;
}

function _createPairedTransaction(txA, txB) {
  // Determine which is outgoing and which is incoming
  const outTx = txA.amount < 0 ? txA : txB;
  const inTx = txA.amount > 0 ? txA : txB;
  
  // Use the later date
  const date = new Date(Math.max(txA.date.getTime(), txB.date.getTime()));
  
  return {
    date: date,
    amount: Math.abs(outTx.amount), // Always positive for transfers
    fromAccount: outTx.fromAccount || inTx.fromAccount,
    toAccount: inTx.toAccount || outTx.toAccount,
    bank: 'Paired Transfer',
    emailId: `${txA.emailId}|${txB.emailId}`,
    type: 'Internal Transfer',
    notes: `Auto-paired: ${outTx.emailId} + ${inTx.emailId}`,
    fingerprint: _generateFingerprint({
      date: date,
      amount: Math.abs(outTx.amount),
      fromAccount: outTx.fromAccount,
      toAccount: inTx.toAccount
    })
  };
}

function _cleanupStaleTransactions() {
  try {
    const ss = _ss();
    const stagingSheet = ss.getSheetByName(SHEET_NAMES.STAGING);
    const mainSheet = ss.getSheetByName(SHEET_NAMES.MAIN);
    const accountsSheet = ss.getSheetByName(SHEET_NAMES.ACCOUNTS);
    
    if (!stagingSheet || stagingSheet.getLastRow() < 2) {
      return;
    }
    
    const data = stagingSheet.getRange(2, 1, stagingSheet.getLastRow() - 1, Object.keys(COLUMNS.STAGING).length).getValues();
    const now = new Date();
    const staleThreshold = CONFIG.STALE_CLEANUP_HOURS * 60 * 60 * 1000;
    let cleanedCount = 0;
    
    // Process in reverse order to maintain row indices
    for (let i = data.length - 1; i >= 0; i--) {
      const stagedAt = new Date(data[i][COLUMNS.STAGING.STAGED_AT - 1]);
      
      if (now.getTime() - stagedAt.getTime() > staleThreshold) {
        // Create transaction from stale staging entry
        const staleTransaction = {
          date: new Date(data[i][COLUMNS.STAGING.DATE - 1]),
          amount: parseFloat(data[i][COLUMNS.STAGING.AMOUNT - 1] || 0),
          fromAccount: data[i][COLUMNS.STAGING.FROM - 1] || '',
          toAccount: data[i][COLUMNS.STAGING.TO - 1] || 'External',
          bank: 'Stale Transaction Cleanup',
          emailId: data[i][COLUMNS.STAGING.EMAIL_ID - 1] || '',
          type: 'Stale Cleanup',
          notes: 'Auto-logged from expired staging',
          fingerprint: data[i][COLUMNS.STAGING.FINGERPRINT - 1] || ''
        };
        
        _commitTransaction(staleTransaction, mainSheet, accountsSheet);
        stagingSheet.deleteRow(i + 2);
        cleanedCount++;
      }
    }
    
    if (cleanedCount > 0) {
      _logInfo(`Cleaned up ${cleanedCount} stale staging entries`);
    }
    
  } catch (error) {
    _logError('Failed to cleanup stale transactions', error);
  }
}

// ===================== HOLDINGS MANAGEMENT =====================

function _updateHoldingsQuantity(accountName, ticker, sharesDelta) {
  try {
    const ss = _ss();
    const holdingsSheet = ss.getSheetByName(SHEET_NAMES.HOLDINGS);
    
    if (!holdingsSheet) {
      _logWarning('Holdings sheet not found');
      return;
    }
    
    const data = holdingsSheet.getDataRange().getValues();
    let found = false;
    
    // Look for existing holding
    for (let i = 1; i < data.length; i++) {
      if (_lc(data[i][COLUMNS.HOLDINGS.ACCOUNT - 1]) === _lc(accountName) && 
          _lc(data[i][COLUMNS.HOLDINGS.TICKER - 1]) === _lc(ticker)) {
        
        const currentShares = parseFloat(data[i][COLUMNS.HOLDINGS.SHARES - 1] || 0);
        const newShares = currentShares + sharesDelta;
        
        holdingsSheet.getRange(i + 1, COLUMNS.HOLDINGS.SHARES).setValue(newShares);
        holdingsSheet.getRange(i + 1, COLUMNS.HOLDINGS.LAST_UPDATED).setValue(new Date());
        
        _logInfo(`Updated ${ticker} in ${accountName}: ${currentShares} → ${newShares} shares`);
        found = true;
        break;
      }
    }
    
    // Add new holding if not found
    if (!found) {
      holdingsSheet.appendRow([
        accountName,
        ticker,
        sharesDelta,
        0, // Price will be updated by price fetching
        0, // Value will be calculated
        new Date()
      ]);
      _logInfo(`Added new holding: ${sharesDelta} shares of ${ticker} in ${accountName}`);
    }
    
  } catch (error) {
    _logError('Failed to update holdings quantity', error);
  }
}

function updateHoldingsAndBalances() {
  try {
    const ss = _ss();
    const holdingsSheet = ss.getSheetByName(SHEET_NAMES.HOLDINGS);
    const accountsSheet = ss.getSheetByName(SHEET_NAMES.ACCOUNTS);
    
    if (!holdingsSheet || holdingsSheet.getLastRow() < 2) {
      _logInfo('Holdings sheet is empty, skipping update');
      return;
    }
    
    const data = holdingsSheet.getRange(2, 1, holdingsSheet.getLastRow() - 1, Object.keys(COLUMNS.HOLDINGS).length).getValues();
    const accountTotals = {};
    let updatedCount = 0;
    
    // Process each holding
    for (let i = 0; i < data.length; i++) {
      const row = i + 2; // Actual sheet row
      const account = _normalize(data[i][COLUMNS.HOLDINGS.ACCOUNT - 1]);
      const ticker = _normalize(data[i][COLUMNS.HOLDINGS.TICKER - 1]);
      const shares = parseFloat(data[i][COLUMNS.HOLDINGS.SHARES - 1] || 0);
      
      if (!account || !ticker || shares === 0) continue;
      
      try {
        // Update price using GOOGLEFINANCE or external API
        const priceCell = holdingsSheet.getRange(row, COLUMNS.HOLDINGS.PRICE);
        let price = 0;
        
        // Try GOOGLEFINANCE first for supported tickers
        if (_isSupportedTicker(ticker)) {
          const formula = `=IFERROR(GOOGLEFINANCE("${ticker}","price"),"ERROR")`;
          priceCell.setFormula(formula);
          
          // Wait a bit for the formula to calculate
          Utilities.sleep(100);
          
          const priceValue = priceCell.getValue();
          if (typeof priceValue === 'number' && priceValue > 0) {
            price = priceValue;
          } else {
            // Fallback to manual price fetching
            price = _fetchPriceFromAPI(ticker);
            if (price > 0) {
              priceCell.setValue(price);
            }
          }
        } else {
          // Use manual price fetching for unsupported tickers
          price = _fetchPriceFromAPI(ticker);
          if (price > 0) {
            priceCell.setValue(price);
          }
        }
        
        // Calculate and update value
        const value = (price && shares) ? price * shares : 0;
        holdingsSheet.getRange(row, COLUMNS.HOLDINGS.VALUE).setValue(value);
        holdingsSheet.getRange(row, COLUMNS.HOLDINGS.LAST_UPDATED).setValue(new Date());
        
        // Format value as currency
        holdingsSheet.getRange(row, COLUMNS.HOLDINGS.VALUE).setNumberFormat('$#,##0.00');
        
        if (value > 0) {
          accountTotals[account] = (accountTotals[account] || 0) + value;
          updatedCount++;
        }
        
        _logInfo(`Updated holding: ${ticker} in ${account}`, {
          shares: shares,
          price: price,
          value: value
        });
        
      } catch (error) {
        _logError(`Failed to update holding: ${ticker}`, error);
      }
    }
    
    // Update account balances for investment accounts
    for (const [accountName, totalValue] of Object.entries(accountTotals)) {
      const accountRow = _findAccountRow(accountsSheet, accountName);
      if (accountRow > 0) {
        accountsSheet.getRange(accountRow, COLUMNS.ACCOUNTS.BALANCE).setValue(totalValue);
        accountsSheet.getRange(accountRow, COLUMNS.ACCOUNTS.BALANCE).setNumberFormat('$#,##0.00');
        accountsSheet.getRange(accountRow, COLUMNS.ACCOUNTS.LAST_UPDATED).setValue(new Date());
        
        _logInfo(`Updated ${accountName} investment balance: ${totalValue.toFixed(2)}`);
      }
    }
    
    _logInfo(`Holdings update completed: ${updatedCount} holdings processed`);
    
  } catch (error) {
    _logError('Failed to update holdings and balances', error);
  }
}

function _isSupportedTicker(ticker) {
  // Check if ticker is supported by GOOGLEFINANCE
  return /^[A-Z]{1,5}(\.[A-Z]{2})?$/.test(ticker) || // Standard stock symbols
         /^[A-Z]{3,4}[.-][A-Z]{3}$/.test(ticker); // Crypto pairs like BTC-CAD
}

function _fetchPriceFromAPI(ticker) {
  try {
    // Try Yahoo Finance for stocks and ETFs
    if (!ticker.includes('-')) {
      const url = `https://query1.finance.yahoo.com/v8/finance/chart/${ticker}`;
      const response = UrlFetchApp.fetch(url, { muteHttpExceptions: true });
      
      if (response.getResponseCode() === 200) {
        const data = JSON.parse(response.getContentText());
        if (data.chart && data.chart.result && data.chart.result[0] && 
            data.chart.result[0].meta && data.chart.result[0].meta.regularMarketPrice) {
          return parseFloat(data.chart.result[0].meta.regularMarketPrice);
        }
      }
    }
    
    // Try CoinGecko for crypto
    if (ticker.includes('-CAD') || ticker.includes('-USD')) {
      const baseCurrency = ticker.split('-')[0].toLowerCase();
      const quoteCurrency = ticker.split('-')[1].toLowerCase();
      
      const url = `https://api.coingecko.com/api/v3/simple/price?ids=${baseCurrency}&vs_currencies=${quoteCurrency}`;
      const response = UrlFetchApp.fetch(url, { muteHttpExceptions: true });
      
      if (response.getResponseCode() === 200) {
        const data = JSON.parse(response.getContentText());
        if (data[baseCurrency] && data[baseCurrency][quoteCurrency]) {
          return parseFloat(data[baseCurrency][quoteCurrency]);
        }
      }
    }
    
    return 0;
    
  } catch (error) {
    _logError(`Failed to fetch price for ${ticker}`, error);
    return 0;
  }
}

// ===================== CATEGORY MANAGEMENT =====================

function learnCategories() {
  try {
    const ss = _ss();
    const txSheet = ss.getSheetByName(SHEET_NAMES.MAIN);
    const catSheet = ss.getSheetByName(SHEET_NAMES.CATEGORIES);
    
    if (!txSheet || txSheet.getLastRow() < 2 || !catSheet || catSheet.getLastRow() < 2) {
      _logInfo('Insufficient data for category learning');
      return;
    }
    
    // Get category rules
    const rules = catSheet.getRange(2, 1, catSheet.getLastRow() - 1, 2).getValues()
      .map(row => ({
        keyword: _lc(row[0] || ''),
        category: row[1] || ''
      }))
      .filter(rule => rule.keyword && rule.category);
    
    if (rules.length === 0) {
      _logInfo('No category rules found');
      return;
    }
    
    // Process transactions
    const txData = txSheet.getRange(2, 1, txSheet.getLastRow() - 1, Object.keys(COLUMNS.TRANSACTIONS).length).getValues();
    let categorizedCount = 0;
    
    for (let i = 0; i < txData.length; i++) {
      const rowIndex = i + 2;
      const existingCategory = _normalize(txData[i][COLUMNS.TRANSACTIONS.CATEGORY - 1]);
      
      // Skip if already categorized (respect manual categories)
      if (existingCategory) continue;
      
      // Create search text from transaction fields
      const searchText = _lc([
        txData[i][COLUMNS.TRANSACTIONS.FROM - 1], // From
        txData[i][COLUMNS.TRANSACTIONS.TO - 1],   // To  
        txData[i][COLUMNS.TRANSACTIONS.BANK - 1], // Bank
        txData[i][COLUMNS.TRANSACTIONS.NOTES - 1] // Notes
      ].join(' '));
      
      // Apply first matching rule
      for (const rule of rules) {
        const keywords = rule.keyword.split(/[|;,]/).map(k => k.trim()).filter(Boolean);
        const matches = keywords.some(keyword => 
          keyword && searchText.includes(keyword)
        );
        
        if (matches) {
          // Use proper cell formatting to prevent spillover
          const categoryCell = txSheet.getRange(rowIndex, COLUMNS.TRANSACTIONS.CATEGORY);
          categoryCell.setValue(rule.category);
          categoryCell.setWrap(false);
          categoryCell.setHorizontalAlignment('left');
          
          categorizedCount++;
          break;
        }
      }
    }
    
    _logInfo(`Category learning completed: ${categorizedCount} transactions categorized`);
    
  } catch (error) {
    _logError('Failed to learn categories', error);
  }
}

function suggestCategoriesFromTransactions() {
  try {
    const ss = _ss();
    const txSheet = ss.getSheetByName(SHEET_NAMES.MAIN);
    let catSheet = ss.getSheetByName(SHEET_NAMES.CATEGORIES);
    
    if (!catSheet) {
      catSheet = ss.insertSheet(SHEET_NAMES.CATEGORIES);
      catSheet.appendRow(['Keyword', 'Category']);
      catSheet.getRange(1, 1, 1, 2).setFontWeight('bold').setBackground('#f0f0f0');
    }
    
    if (!txSheet || txSheet.getLastRow() < 2) {
      SpreadsheetApp.getUi().alert('No transactions found for category suggestions');
      return;
    }
    
    const txData = txSheet.getRange(2, 1, txSheet.getLastRow() - 1, 6).getValues();
    const merchantCounts = {};
    const commonWords = new Set([
      'payment', 'transfer', 'inc', 'ltd', 'corp', 'on', 'toronto', 
      'thank', 'you', 'ltd/ltée', 'e-transfer', 'purchase', 'the', 'and', 'or',
      'auto-logged', 'standalone', 'paired'
    ]);
    
    // Extract potential merchants/keywords from TO field
    txData.forEach(row => {
      const toAccount = _lc(row[COLUMNS.TRANSACTIONS.TO - 1] || '');
      const bank = _lc(row[COLUMNS.TRANSACTIONS.BANK - 1] || '');
      const notes = _lc(row[COLUMNS.TRANSACTIONS.NOTES - 1] || '');
      
      const searchText = [toAccount, bank, notes].join(' ')
        .replace(/internet banking|e-transfer from|payment thank you|external to/gi, '')
        .replace(/[\*#\d-]/g, ' ')
        .trim();
      
      const words = searchText.split(/\s+/)
        .filter(word => 
          word.length > 3 && 
          !commonWords.has(word) && 
          !/^\d+$/.test(word)
        );
      
      words.forEach(word => {
        merchantCounts[word] = (merchantCounts[word] || 0) + 1;
      });
    });
    
    // Get existing categories to avoid duplicates
    const existingKeywords = catSheet.getLastRow() > 1 ? 
      catSheet.getRange(2, 1, catSheet.getLastRow() - 1, 1).getValues()
        .flat()
        .map(k => _lc(k || '')) : [];
    
    // Add suggestions (merchants appearing more than once)
    const suggestions = Object.entries(merchantCounts)
      .filter(([merchant, count]) => 
        count > 1 && 
        !existingKeywords.includes(_lc(merchant))
      )
      .sort((a, b) => b[1] - a[1])
      .slice(0, 25); // Limit to top 25
    
    let addedCount = 0;
    suggestions.forEach(([merchant, count]) => {
      catSheet.appendRow([merchant.toUpperCase(), '']);
      addedCount++;
    });
    
    SpreadsheetApp.getUi().alert(
      `Added ${addedCount} category suggestions. ` +
      'Please review and assign categories in the Categories sheet.'
    );
    
    _logInfo(`Category suggestions completed: ${addedCount} suggestions added`);
    
  } catch (error) {
    _logError('Failed to suggest categories', error);
  }
}

// ===================== CSV IMPORT SYSTEM =====================

function importFromCsv() {
  try {
    const ss = _ss();
    const importSheet = ss.getSheetByName(SHEET_NAMES.CSV_IMPORT);
    const txSheet = ss.getSheetByName(SHEET_NAMES.MAIN);
    const accountsSheet = ss.getSheetByName(SHEET_NAMES.ACCOUNTS);
    
    if (!importSheet || importSheet.getLastRow() < 2) {
      SpreadsheetApp.getUi().alert('CSV Import sheet is empty. Please paste your CSV data first.');
      return;
    }
    
    const importData = importSheet.getDataRange().getValues();
    
    // Detect CSV profile
    let detectedProfile = null;
    const allText = importData.flat().join(' ').toLowerCase();
    
    for (const profile of CSV_PROFILES) {
      if (allText.includes(profile.identifyingKeyword.toLowerCase())) {
        detectedProfile = profile;
        break;
      }
    }
    
    if (!detectedProfile) {
      SpreadsheetApp.getUi().alert('Could not detect bank format from CSV data.');
      return;
    }
    
    // Get existing transactions for deduplication
    const existingTxSet = new Set();
    if (txSheet.getLastRow() > 1) {
      const existingData = txSheet.getRange(2, 1, txSheet.getLastRow() - 1, 4).getValues();
      existingData.forEach(row => {
        const key = `${new Date(row[0]).toDateString()}|${parseFloat(row[1] || 0).toFixed(2)}|${row[2]}|${row[3]}`;
        existingTxSet.add(key);
      });
    }
    
    let importedCount = 0;
    let errors = 0;
    
    // Process each row
    importData.forEach((row, index) => {
      if (index === 0) return; // Skip headers
      
      try {
        const cols = detectedProfile.columnMap;
        let txDate, amount, description;
        
        // Parse date
        const dateValue = row[cols.date - 1];
        if (dateValue instanceof Date) {
          txDate = dateValue;
        } else if (typeof dateValue === 'string') {
          // Handle various date formats
          if (/\d{2}-\d{2}-\d{4}/.test(dateValue)) {
            const parts = dateValue.split('-');
            txDate = new Date(parseInt(parts[2]), parseInt(parts[1]) - 1, parseInt(parts[0]));
          } else {
            txDate = new Date(dateValue);
          }
        }
        
        if (!txDate || isNaN(txDate.getTime())) return;
        
        // Parse amount
        if (cols.amount) {
          amount = parseFloat(row[cols.amount - 1] || 0);
        } else {
          const debit = parseFloat(row[cols.debit - 1] || 0);
          const credit = parseFloat(row[cols.credit - 1] || 0);
          amount = credit - debit;
        }
        
        if (isNaN(amount) || amount === 0) return;
        
        // Get description
        description = _normalize(row[cols.description - 1] || '');
        if (!description) return;
        
        // Determine accounts
        const fromAccount = amount < 0 ? _normalizeAccountName(detectedProfile.accountName) : 
                           _normalizeAccountName(description);
        const toAccount = amount > 0 ? _normalizeAccountName(detectedProfile.accountName) : 
                         _normalizeAccountName(description);
        
        // Check for duplicates
        const txKey = `${txDate.toDateString()}|${amount.toFixed(2)}|${fromAccount}|${toAccount}`;
        if (existingTxSet.has(txKey)) return;
        
        // Create and commit transaction
        const transaction = {
          date: txDate,
          amount: amount,
          fromAccount: fromAccount,
          toAccount: toAccount,
          bank: `${detectedProfile.name} CSV Import`,
          emailId: `CSV-${Date.now()}-${index}`,
          type: 'CSV Import',
          notes: `Imported from ${detectedProfile.name} CSV`
        };
        
        _commitTransaction(transaction, txSheet, accountsSheet);
        importedCount++;
        
      } catch (error) {
        _logError(`Failed to process CSV row ${index}`, error);
        errors++;
      }
    });
    
    // Clear import sheet
    importSheet.clearContents();
    
    const message = `CSV Import completed!\n` +
                   `Detected format: ${detectedProfile.name}\n` +
                   `Imported ${importedCount} new transactions\n` +
                   `Errors: ${errors}`;
    
    SpreadsheetApp.getUi().alert(message);
    
    _logInfo(`CSV import completed`, {
      profile: detectedProfile.name,
      imported: importedCount,
      errors: errors
    });
    
  } catch (error) {
    _logError('Failed to import CSV', error);
    SpreadsheetApp.getUi().alert('CSV import failed. Please check the logs.');
  }
}

// ===================== DASHBOARD & REPORTING =====================

function buildDashboard() {
  try {
    const ss = _ss();
    const txSheet = ss.getSheetByName(SHEET_NAMES.MAIN);
    let dashSheet = ss.getSheetByName(SHEET_NAMES.DASHBOARD);
    
    // Clear existing dashboard
    if (dashSheet) {
      dashSheet.clear();
      dashSheet.getCharts().forEach(chart => dashSheet.removeChart(chart));
    } else {
      dashSheet = ss.insertSheet(SHEET_NAMES.DASHBOARD, 0);
    }
    
    // Dashboard header
    dashSheet.getRange('A1').setValue('Financial Dashboard')
      .setFontSize(18)
      .setFontWeight('bold')
      .setHorizontalAlignment('center');
    
    dashSheet.getRange('A2').setValue(`Last Updated: ${new Date().toLocaleString()}`)
      .setFontSize(10)
      .setFontStyle('italic');
    
    if (!txSheet || txSheet.getLastRow() < 2) {
      dashSheet.getRange('A4').setValue('No transaction data available for dashboard');
      return;
    }
    
    // Analyze recent transactions
    const txData = txSheet.getRange(2, 1, txSheet.getLastRow() - 1, Object.keys(COLUMNS.TRANSACTIONS).length).getValues();
    const cutoffDate = new Date();
    cutoffDate.setDate(cutoffDate.getDate() - CONFIG.DASHBOARD_ANALYSIS_DAYS);
    
    const categoryStats = {};
    const expensesByCategory = {};
    const incomeByMonth = {};
    const expensesByMonth = {};
    
    txData.forEach(row => {
      const date = new Date(row[COLUMNS.TRANSACTIONS.DATE - 1]);
      const amount = parseFloat(row[COLUMNS.TRANSACTIONS.AMOUNT - 1] || 0);
      const category = _normalize(row[COLUMNS.TRANSACTIONS.CATEGORY - 1]) || 'Uncategorized';
      
      if (isNaN(date.getTime()) || date < cutoffDate) return;
      
      const monthKey = `${date.getFullYear()}-${String(date.getMonth() + 1).padStart(2, '0')}`;
      
      if (amount < 0) {
        // Expenses
        const absAmount = Math.abs(amount);
        categoryStats[category] = (categoryStats[category] || 0) + 1;
        expensesByCategory[category] = (expensesByCategory[category] || 0) + absAmount;
        expensesByMonth[monthKey] = (expensesByMonth[monthKey] || 0) + absAmount;
      } else {
        // Income
        incomeByMonth[monthKey] = (incomeByMonth[monthKey] || 0) + amount;
      }
    });
    
    // Create expense pie chart
    const expenseData = CONFIG.PIE_MODE === 'COUNT' ? categoryStats : expensesByCategory;
    const sortedExpenseData = Object.entries(expenseData)
      .sort((a, b) => b[1] - a[1])
      .slice(0, 8); // Top 8 categories
    
    if (sortedExpenseData.length > 0) {
      const chartHeaders = [['Category', CONFIG.PIE_MODE === 'COUNT' ? 'Count' : 'Amount']];
      const chartRows = sortedExpenseData.map(([category, value]) => [category, value]);
      const chartTable = chartHeaders.concat(chartRows);
      
      // Place data in hidden columns
      const dataRange = dashSheet.getRange(4, 15, chartTable.length, 2);
      dataRange.setValues(chartTable);
      
      const pieTitle = CONFIG.PIE_MODE === 'COUNT' ? 
        `Expenses by Category (Transaction Count - Last ${CONFIG.DASHBOARD_ANALYSIS_DAYS} Days)` :
        `Expenses by Category (Amount - Last ${CONFIG.DASHBOARD_ANALYSIS_DAYS} Days)`;
      
      const pieChart = dashSheet.newChart()
        .setChartType(Charts.ChartType.PIE)
        .addRange(dataRange)
        .setOption('title', pieTitle)
        .setOption('titleTextStyle', {fontSize: 14, bold: true})
        .setOption('legend', {position: 'right', textStyle: {fontSize: 10}})
        .setOption('colors', ['#FF6B6B', '#4ECDC4', '#45B7D1', '#96CEB4', '#FFEAA7', '#DDA0DD', '#98D8C8', '#F7DC6F'])
        .setPosition(4, 1, 0, 0)
        .build();
      
      dashSheet.insertChart(pieChart);
      
      // Hide data columns
      dashSheet.hideColumns(15, 2);
    }
    
    // Create income vs expenses trend chart
    const monthlyData = {};
    Object.keys(incomeByMonth).concat(Object.keys(expensesByMonth)).forEach(month => {
      monthlyData[month] = {
        income: incomeByMonth[month] || 0,
        expenses: expensesByMonth[month] || 0
      };
    });
    
    const sortedMonths = Object.keys(monthlyData).sort();
    
    if (sortedMonths.length > 0) {
      const trendHeaders = [['Month', 'Income', 'Expenses', 'Net']];
      const trendRows = sortedMonths.map(month => [
        month,
        monthlyData[month].income,
        monthlyData[month].expenses,
        monthlyData[month].income - monthlyData[month].expenses
      ]);
      const trendTable = trendHeaders.concat(trendRows);
      
      const trendRange = dashSheet.getRange(4, 17, trendTable.length, 4);
      trendRange.setValues(trendTable);
      
      const trendChart = dashSheet.newChart()
        .setChartType(Charts.ChartType.COLUMN)
        .addRange(trendRange)
        .setOption('title', 'Income vs Expenses Trend')
        .setOption('titleTextStyle', {fontSize: 14, bold: true})
        .setOption('hAxis', {title: 'Month'})
        .setOption('vAxis', {title: 'Amount ($)', format: '$#,###'})
        .setOption('series', {
          0: {color: '#4CAF50', type: 'columns'}, // Income
          1: {color: '#FF5722', type: 'columns'}, // Expenses
          2: {color: '#2196F3', type: 'line', targetAxisIndex: 1} // Net
        })
        .setPosition(24, 1, 0, 0)
        .build();
      
      dashSheet.insertChart(trendChart);
      
      // Hide trend data columns
      dashSheet.hideColumns(17, 4);
    }
    
    // Add Net Worth chart if historical data exists
    const nwSheet = ss.getSheetByName(SHEET_NAMES.NETWORTH);
    if (nwSheet && nwSheet.getLastRow() > 1) {
      const netWorthChart = dashSheet.newChart()
        .setChartType(Charts.ChartType.LINE)
        .addRange(nwSheet.getRange(1, 1, nwSheet.getLastRow(), 2))
        .setOption('title', 'Net Worth Over Time')
        .setOption('titleTextStyle', {fontSize: 14, bold: true})
        .setOption('hAxis', {title: 'Date'})
        .setOption('vAxis', {title: 'Net Worth ($)', format: '$#,###'})
        .setOption('legend', {position: 'none'})
        .setOption('colors', ['#9C27B0'])
        .setPosition(44, 1, 0, 0)
        .build();
      
      dashSheet.insertChart(netWorthChart);
    }
    
    // Add summary statistics
    _addDashboardSummary(dashSheet, txData, cutoffDate);
    
    _logInfo('Dashboard rebuilt successfully');
    
  } catch (error) {
    _logError('Failed to build dashboard', error);
  }
}

function _addDashboardSummary(dashSheet, txData, cutoffDate) {
  try {
    let totalIncome = 0;
    let totalExpenses = 0;
    let transactionCount = 0;
    let largestExpense = 0;
    let largestIncome = 0;
    const categoryTotals = {};
    
    txData.forEach(row => {
      const date = new Date(row[COLUMNS.TRANSACTIONS.DATE - 1]);
      const amount = parseFloat(row[COLUMNS.TRANSACTIONS.AMOUNT - 1] || 0);
      const category = _normalize(row[COLUMNS.TRANSACTIONS.CATEGORY - 1]) || 'Uncategorized';
      
      if (isNaN(date.getTime()) || date < cutoffDate) return;
      
      transactionCount++;
      if (amount > 0) {
        totalIncome += amount;
        largestIncome = Math.max(largestIncome, amount);
      } else {
        const absAmount = Math.abs(amount);
        totalExpenses += absAmount;
        largestExpense = Math.max(largestExpense, absAmount);
        categoryTotals[category] = (categoryTotals[category] || 0) + absAmount;
      }
    });
    
    const netFlow = totalIncome - totalExpenses;
    const topCategory = Object.entries(categoryTotals)
      .sort((a, b) => b[1] - a[1])[0];
    
    // Summary section
    dashSheet.getRange('A60').setValue(`${CONFIG.DASHBOARD_ANALYSIS_DAYS}-Day Financial Summary`)
      .setFontWeight('bold')
      .setFontSize(14)
      .setBackground('#e1f5fe');
    
    const summaryData = [
      ['Total Income:', totalIncome, '$#,##0.00'],
      ['Total Expenses:', totalExpenses, '$#,##0.00'],
      ['Net Flow:', netFlow, '$#,##0.00'],
      ['Largest Single Income:', largestIncome, '$#,##0.00'],
      ['Largest Single Expense:', largestExpense, '$#,##0.00'],
      ['Total Transactions:', transactionCount, '#,##0'],
      ['Top Expense Category:', topCategory ? `${topCategory[0]} (${topCategory[1].toFixed(2)})` : 'N/A', '']
    ];
    
    summaryData.forEach((item, index) => {
      const row = 62 + index;
      dashSheet.getRange(row, 1).setValue(item[0]).setFontWeight('bold');
      dashSheet.getRange(row, 2).setValue(item[1]);
      if (item[2]) {
        dashSheet.getRange(row, 2).setNumberFormat(item[2]);
      }
      
      // Color coding for net flow
      if (item[0].includes('Net Flow')) {
        const color = netFlow >= 0 ? '#4CAF50' : '#FF5722';
        dashSheet.getRange(row, 2).setFontColor(color).setFontWeight('bold');
      }
    });
    
    // Add account balances summary
    const ss = _ss();
    const accountsSheet = ss.getSheetByName(SHEET_NAMES.ACCOUNTS);
    if (accountsSheet && accountsSheet.getLastRow() > 1) {
      dashSheet.getRange('D60').setValue('Account Balances')
        .setFontWeight('bold')
        .setFontSize(14)
        .setBackground('#f3e5f5');
      
      const accountData = accountsSheet.getRange(2, 1, accountsSheet.getLastRow() - 1, 3).getValues();
      let totalNetWorth = 0;
      
      accountData.forEach((row, index) => {
        const accountName = row[0];
        const balance = parseFloat(row[1] || 0);
        const lastUpdated = row[2];
        
        const displayRow = 62 + index;
        dashSheet.getRange(displayRow, 4).setValue(accountName);
        dashSheet.getRange(displayRow, 5).setValue(balance).setNumberFormat('$#,##0.00');
        dashSheet.getRange(displayRow, 6).setValue(lastUpdated).setNumberFormat('mm/dd/yyyy');
        
        // Color coding for balances
        const color = balance >= 0 ? '#4CAF50' : '#FF5722';
        dashSheet.getRange(displayRow, 5).setFontColor(color);
        
        totalNetWorth += balance;
      });
      
      // Total net worth
      const netWorthRow = 62 + accountData.length + 1;
      dashSheet.getRange(netWorthRow, 4).setValue('TOTAL NET WORTH:')
        .setFontWeight('bold')
        .setBackground('#fff3e0');
      dashSheet.getRange(netWorthRow, 5).setValue(totalNetWorth)
        .setNumberFormat('$#,##0.00')
        .setFontWeight('bold')
        .setFontColor('#FF6F00')
        .setBackground('#fff3e0');
    }
    
  } catch (error) {
    _logError('Failed to add dashboard summary', error);
  }
}

function _updateNetWorthHistory() {
  try {
    const ss = _ss();
    const accountsSheet = ss.getSheetByName(SHEET_NAMES.ACCOUNTS);
    let nwSheet = ss.getSheetByName(SHEET_NAMES.NETWORTH);
    
    if (!nwSheet) {
      nwSheet = ss.insertSheet(SHEET_NAMES.NETWORTH);
      nwSheet.appendRow(['Date', 'Net Worth']);
      nwSheet.getRange(1, 1, 1, 2).setFontWeight('bold').setBackground('#f0f0f0');
    }
    
    if (!accountsSheet || accountsSheet.getLastRow() < 2) {
      _logInfo('No account data for net worth calculation');
      return;
    }
    
    // Calculate total net worth
    const balances = accountsSheet.getRange(2, COLUMNS.ACCOUNTS.BALANCE, 
      accountsSheet.getLastRow() - 1, 1).getValues();
    const totalNetWorth = balances.reduce((sum, row) => sum + parseFloat(row[0] || 0), 0);
    
    const today = new Date().toDateString();
    const lastRow = nwSheet.getLastRow();
    
    // Update today's entry or add new one
    if (lastRow > 1) {
      const lastDate = new Date(nwSheet.getRange(lastRow, 1).getValue()).toDateString();
      if (lastDate === today) {
        // Update existing entry
        nwSheet.getRange(lastRow, 2).setValue(totalNetWorth);
      } else {
        // Add new entry
        nwSheet.appendRow([new Date(), totalNetWorth]);
      }
    } else {
      // First entry
      nwSheet.appendRow([new Date(), totalNetWorth]);
    }
    
    // Format the net worth column
    const nwColumn = nwSheet.getRange(2, 2, nwSheet.getLastRow() - 1, 1);
    nwColumn.setNumberFormat('$#,##0.00');
    
    _logInfo(`Net worth updated: ${totalNetWorth.toFixed(2)}`);
    
  } catch (error) {
    _logError('Failed to update net worth history', error);
  }
}

// ===================== FORMATTING & CONDITIONAL FORMATTING =====================

function applyConditionalFormatting() {
  try {
    const ss = _ss();
    const txSheet = ss.getSheetByName(SHEET_NAMES.MAIN);
    const accountsSheet = ss.getSheetByName(SHEET_NAMES.ACCOUNTS);
    
    // Format transaction amounts
    if (txSheet && txSheet.getLastRow() > 1) {
      const txRange = txSheet.getRange(`B2:B${txSheet.getMaxRows()}`);
      txSheet.clearConditionalFormatRules();
      
      const txRules = [
        SpreadsheetApp.newConditionalFormatRule()
          .whenNumberLessThan(0)
          .setFontColor('#D32F2F')
          .setBackground('#FFEBEE')
          .setRanges([txRange])
          .build(),
        SpreadsheetApp.newConditionalFormatRule()
          .whenNumberGreaterThan(0)
          .setFontColor('#388E3C')
          .setBackground('#E8F5E8')
          .setRanges([txRange])
          .build()
      ];
      
      txSheet.setConditionalFormatRules(txRules);
      
      // Format amount column as currency
      txRange.setNumberFormat('$#,##0.00');
    }
    
    // Format account balances
    if (accountsSheet && accountsSheet.getLastRow() > 1) {
      const accRange = accountsSheet.getRange(`B2:B${accountsSheet.getMaxRows()}`);
      accountsSheet.clearConditionalFormatRules();
      
      const accRules = [
        SpreadsheetApp.newConditionalFormatRule()
          .whenNumberLessThan(0)
          .setBackground('#FFEBEE')
          .setFontColor('#D32F2F')
          .setRanges([accRange])
          .build(),
        SpreadsheetApp.newConditionalFormatRule()
          .whenNumberGreaterThan(0)
          .setBackground('#E8F5E8')
          .setFontColor('#388E3C')
          .setRanges([accRange])
          .build()
      ];
      
      accountsSheet.setConditionalFormatRules(accRules);
      
      // Format balance column as currency
      accRange.setNumberFormat('$#,##0.00');
    }
    
    _logInfo('Conditional formatting applied successfully');
    
  } catch (error) {
    _logError('Failed to apply conditional formatting', error);
  }
}

