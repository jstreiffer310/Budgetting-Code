function emergencyRecovery() {
  try {
    _logInfo('=== Starting emergency recovery ===');
    
    // Ensure all sheets exist
    _ensureSheetsAndHeaders();
    
    // Clear any corrupted staging entries
    const ss = _ss();
    const stagingSheet = ss.getSheetByName(SHEET_NAMES.STAGING);
    
    if (stagingSheet && stagingSheet.getLastRow() > 1) {
      const data = stagingSheet.getRange(2, 1, stagingSheet.getLastRow() - 1, Object.keys(COLUMNS.STAGING).length).getValues();
      const oneWeekAgo = new Date(Date.now() - 7 * 24 * 60 * 60 * 1000);
      let clearedCount = 0;
      
      for (let i = data.length - 1; i >= 0; i--) {
        const stagedAt = new Date(data[i][COLUMNS.STAGING.STAGED_AT - 1]);
        if (stagedAt < oneWeekAgo || isNaN(stagedAt.getTime())) {
          stagingSheet.deleteRow(i + 2);
          clearedCount++;
        }
      }
      
      _logInfo(`Cleared ${clearedCount} corrupted/stale staging entries`);
    }
    
    // Repair common data issues
    repairCommonIssues();
    
    // Apply basic formatting
    applyConditionalFormatting();
    
    // Update net worth
    _updateNetWorthHistory();
    
    _logInfo('=== Emergency recovery completed ===');
    
    SpreadsheetApp.getUi().alert('✅ Emergency recovery completed!\n\nBasic functionality has been restored.');
    
  } catch (error) {
    _logError('Emergency recovery failed', error);
    SpreadsheetApp.getUi().alert('❌ Emergency recovery failed. Manual intervention required.');
  }
}

