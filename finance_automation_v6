    _safeExecute(applyConditionalFormatting, this);
    
    const endTime = new Date();
    const duration = Math.round((endTime - startTime) / 1000);
    
    _logInfo(`=== Finance automation process completed successfully in ${duration}s ===`);
    
    SpreadsheetApp.getUi().alert(
      '✅ Finance automation completed successfully!\n\n' +
      `Process completed in ${duration} seconds.\n` +
      'Check the Dashboard sheet for updated charts and summaries.'
    );
    
  } catch (error) {
    _logError('Finance automation process failed', error);
    SpreadsheetApp.getUi().alert(
      '❌ Finance automation failed.\n\n' +
      `Error: ${error.message}\n\n` +
      'Please check the execution log for details.'
    );
