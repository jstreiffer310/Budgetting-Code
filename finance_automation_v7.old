    // Try to show a simple alert without complex logging
    try {
      SpreadsheetApp.getUi().alert(
        'Finance Automation V6 Setup Error\n\n' +
        'There was an issue setting up the system. Error: ' + error.message + '\n\n' +
        'Please check the execution log for more details.'
      );
    } catch (alertError) {
      // If even the alert fails, just log to console
      console.error('Could not show error alert:', alertError);
    }
  }
}

function onEdit(e) {
  try {
    const range = e.range;
    const sheet = range.getSheet();

    // Handle manual account balance changes
    if (
      sheet.getName() === SHEET_NAMES.ACCOUNTS &&
      range.getColumn() === COLUMNS.ACCOUNTS.BALANCE &&
      range.getRow() > 1
    ) {
      const ss = _ss();
      const txSheet = ss.getSheetByName(SHEET_NAMES.MAIN);

      const accountName = sheet.getRange(range.getRow(), COLUMNS.ACCOUNTS.NAME).getValue();
      const oldValue = parseFloat(e.oldValue || 0);
      const newValue = parseFloat(e.value || 0);
      const difference = newValue - oldValue;

      // Only log significant changes (> 1 cent)
      if (Math.abs(difference) > 0.01) {
        // Create adjustment transaction
        const adjustmentTx = {
          date: new Date(),
          amount: difference,
          fromAccount: difference < 0 ? accountName : 'Manual Adjustment',
          toAccount: difference > 0 ? accountName : 'Manual Adjustment',
          bank: 'Manual Correction',
          emailId: `MANUAL-${Date.now()}`,
          type: 'Manual Adjustment',
          notes: `Balance manually adjusted: ${oldValue.toFixed(2)} → ${newValue.toFixed(2)}`
        };

        // Log the adjustment without double-adjusting the balance
        const row = [
          adjustmentTx.date,
          adjustmentTx.amount,
          adjustmentTx.fromAccount,
          adjustmentTx.toAccount,
          adjustmentTx.bank,
          adjustmentTx.notes,
          adjustmentTx.emailId,
          'Manual',
          adjustmentTx.type,
          _generateFingerprint(adjustmentTx)
        ];

        txSheet.appendRow(row);

        // Update the timestamp
        sheet.getRange(range.getRow(), COLUMNS.ACCOUNTS.LAST_UPDATED).setValue(new Date());

        _logInfo(`Manual adjustment logged for ${accountName}`, {
          difference: difference,
          oldValue: oldValue,
          newValue: newValue
        });
      }
    }
  } catch (error) {
    _logError('Error in onEdit trigger', error);
  }
}

// ===================== MAIN PROCESSING FUNCTION =====================

function processEverything() {
  try {
    _logInfo('=== Starting complete finance automation process ===');
    
    const startTime = new Date();
    _ensureSheetsAndHeaders();
    
    // Step 1: Process new emails
    _logInfo('Step 1: Processing new emails...');
    _safeExecute(_processNewEmails, this);
    
    // Step 2: Clean up stale staged transactions
    _logInfo('Step 2: Cleaning up stale transactions...');
    _safeExecute(_cleanupStaleTransactions, this);
    
    // Step 3: Pair staged transfers
    _logInfo('Step 3: Pairing staged transfers...');
    _safeExecute(_pairStagedTransfers, this);
    
    // Step 4: Update holdings and account balances
    _logInfo('Step 4: Updating holdings and balances...');
    _safeExecute(updateHoldingsAndBalances, this);
    
    // Step 5: Learn and apply categories
    _logInfo('Step 5: Learning categories...');
    _safeExecute(learnCategories, this);
    
    // Step 6: Update net worth history
    _logInfo('Step 6: Updating net worth history...');
    _safeExecute(_updateNetWorthHistory, this);
    
    // Step 7: Rebuild dashboard
    _logInfo('Step 7: Rebuilding dashboard...');
    _safeExecute(buildDashboard, this);
    
    // Step 8: Apply formatting
    _logInfo('Step 8: Applying formatting...');
    _safeExecute(applyConditionalFormatting, this);
    
    const endTime = new Date();
    const duration = Math.round((endTime - startTime) / 1000);
    
    _logInfo(`=== Finance automation process completed successfully in ${duration}s ===`);
    
    SpreadsheetApp.getUi().alert(
      '✅ Finance automation completed successfully!\n\n' +
      `Process completed in ${duration} seconds.\n` +
      'Check the Dashboard sheet for updated charts and summaries.'
    );
    
  } catch (error) {
    _logError('Finance automation process failed', error);
    SpreadsheetApp.getUi().alert(
      '❌ Finance automation failed.\n\n' +
      `Error: ${error.message}\n\n` +
      'Please check the execution log for details.'
    );
  }
}

