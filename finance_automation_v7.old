// ===================== TESTING & DEVELOPMENT HELPERS =====================

function testEmailParsing() {
  try {
    const threads = GmailApp.search(`label:${CONFIG.GMAIL_LABEL} newer_than:1d`);
    
    if (threads.length === 0) {
      SpreadsheetApp.getUi().alert('No recent emails found with the specified label.');
      return;
    }
    
    let testResults = [];
    let successCount = 0;
    let totalCount = 0;
    
    threads.slice(0, 3).forEach(thread => { // Test first 3 threads
      thread.getMessages().slice(0, 2).forEach(message => { // Test first 2 messages per thread
        totalCount++;
        
        const from = message.getFrom();
        const subject = message.getSubject();
        const plainBody = message.getPlainBody();
        const htmlBody = _htmlToText(message.getBody());
        const body = plainBody + '\n' + htmlBody;
        
        testResults.push(`From: ${from}`);
        testResults.push(`Subject: ${subject}`);
        
        let transaction = null;
        const fromLower = _lc(from);
        
        if (fromLower.includes('cibc')) {
          transaction = _parseCibcEmail(message, subject, body, null);
        } else if (fromLower.includes('pcfinancial')) {
          transaction = _parsePcFinancialEmail(message, subject, body);
        } else if (fromLower.includes('payments.interac')) {
          transaction = _parseInteracEmail(message, subject, body);
        } else if (fromLower.includes('wealthsimple')) {
          transaction = _parseWealthsimpleEmail(message, subject, body);
        }
        
        if (transaction) {
          testResults.push(`✅ Parsed: ${Math.abs(transaction.amount)} ${transaction.direction || 'N/A'} (${transaction.fromAccount} → ${transaction.toAccount})`);
          successCount++;
        } else {
          testResults.push(`❌ Failed to parse`);
        }
        
        testResults.push('---');
      });
    });
    
    testResults.push(`Summary: ${successCount}/${totalCount} emails parsed successfully`);
    
    const results = testResults.join('\n');
    Logger.log(results);
    SpreadsheetApp.getUi().alert(`Email parsing test completed.\n\nSummary: ${successCount}/${totalCount} emails parsed successfully.\n\nCheck execution logs for detailed results.`);
    
    _logInfo('Email parsing test completed', {
      successCount: successCount,
      totalCount: totalCount,
      successRate: `${(successCount/totalCount*100).toFixed(1)}%`
    });
    
  } catch (error) {
    _logError('Email parsing test failed', error);
    SpreadsheetApp.getUi().alert('Email parsing test failed. Check logs.');
  }
}

// ===================== PERFORMANCE OPTIMIZATION =====================

function optimizeSpreadsheet() {
  try {
    const ss = _ss();
    let optimizations = 0;
    
    // Remove empty rows/columns from all sheets
    Object.values(SHEET_NAMES).forEach(sheetName => {
      const sheet = ss.getSheetByName(sheetName);
      if (!sheet) return;
      
      const lastRow = sheet.getLastRow();
      const lastCol = sheet.getLastColumn();
      const maxRows = sheet.getMaxRows();
      const maxCols = sheet.getMaxColumns();
      
      // Remove excess rows (keep reasonable buffer)
      if (maxRows > lastRow + 100 && maxRows > 1000) {
        const rowsToDelete = Math.min(maxRows - lastRow - 100, maxRows - 1000);
        if (rowsToDelete > 0) {
          sheet.deleteRows(lastRow + 101, rowsToDelete);
          optimizations++;
        }
      }
      
      // Remove excess columns (keep reasonable buffer)
      if (maxCols > lastCol + 10 && maxCols > 26) {
        const colsToDelete = Math.min(maxCols - lastCol - 10, maxCols - 26);
        if (colsToDelete > 0) {
          sheet.deleteColumns(lastCol + 11, colsToDelete);
          optimizations++;
        }
      }
    });
    
    SpreadsheetApp.getUi().alert(`✅ Optimization completed!\n\n${optimizations} optimizations applied.`);
    _logInfo(`Spreadsheet optimization completed: ${optimizations} optimizations applied`);
    
  } catch (error) {
    _logError('Failed to optimize spreadsheet', error);
    SpreadsheetApp.getUi().alert('❌ Optimization failed. Check logs.');
  }
}

// ===================== SECURITY & ACCESS CONTROL =====================

function isAuthorizedUser() {
  // Add authorized email addresses here
  const authorizedUsers = [
    // 'user@example.com'
  ];
  
  const currentUser = Session.getActiveUser().getEmail();
  
  // If no authorized users specified, allow all (default behavior)
  if (authorizedUsers.length === 0) {
    return true;
  }
  
  return authorizedUsers.includes(currentUser);
}

function checkAuthorization() {
  if (!isAuthorizedUser()) {
    const message = 'You are not authorized to use this finance automation system.';
    SpreadsheetApp.getUi().alert(message);
    _logWarning('Unauthorized access attempt', {
      user: Session.getActiveUser().getEmail()
    });
    throw new Error(message);
  }
}

// ===================== ERROR RECOVERY & EMERGENCY FUNCTIONS =====================

function emergencyRecovery() {
  try {
    _logInfo('=== Starting emergency recovery ===');
    
    // Ensure all sheets exist
    _ensureSheetsAndHeaders();
    
    // Clear any corrupted staging entries
    const ss = _ss();
    const stagingSheet = ss.getSheetByName(SHEET_NAMES.STAGING);
    
    if (stagingSheet && stagingSheet.getLastRow() > 1) {
      const data = stagingSheet.getRange(2, 1, stagingSheet.getLastRow() - 1, Object.keys(COLUMNS.STAGING).length).getValues();
      const oneWeekAgo = new Date(Date.now() - 7 * 24 * 60 * 60 * 1000);
      let clearedCount = 0;
      
      for (let i = data.length - 1; i >= 0; i--) {
        const stagedAt = new Date(data[i][COLUMNS.STAGING.STAGED_AT - 1]);
        if (stagedAt < oneWeekAgo || isNaN(stagedAt.getTime())) {
          stagingSheet.deleteRow(i + 2);
          clearedCount++;
        }
      }
      
      _logInfo(`Cleared ${clearedCount} corrupted/stale staging entries`);
    }
    
    // Repair common data issues
    repairCommonIssues();
    
    // Apply basic formatting
    applyConditionalFormatting();
    
    // Update net worth
    _updateNetWorthHistory();
    
    _logInfo('=== Emergency recovery completed ===');
    
    SpreadsheetApp.getUi().alert('✅ Emergency recovery completed!\n\nBasic functionality has been restored.');
    
  } catch (error) {
    _logError('Emergency recovery failed', error);
    SpreadsheetApp.getUi().alert('❌ Emergency recovery failed. Manual intervention required.');
  }
}

// ===================== SCHEDULED TRIGGERS =====================

function createScheduledTrigger() {
  try {
    // Delete existing triggers
    ScriptApp.getProjectTriggers().forEach(trigger => {
      if (trigger.getHandlerFunction() === 'processEverything') {
        ScriptApp.deleteTrigger(trigger);
      }
    });
    
    // Create new daily trigger
    ScriptApp.newTrigger('processEverything')
      .timeBased()
      .everyDays(1)
      .atHour(9) // Run at 9 AM
      .create();
    
    SpreadsheetApp.getUi().alert('✅ Scheduled daily trigger created for 9:00 AM');
    _logInfo('Scheduled trigger created');
    
  } catch (error) {
    _logError('Failed to create scheduled trigger', error);
    SpreadsheetApp.getUi().alert('❌ Failed to create scheduled trigger. Check logs.');
  }
}

function deleteScheduledTriggers() {
  try {
    let deletedCount = 0;
    ScriptApp.getProjectTriggers().forEach(trigger => {
      if (trigger.getHandlerFunction() === 'processEverything') {
        ScriptApp.deleteTrigger(trigger);
        deletedCount++;
      }
    });
    
    SpreadsheetApp.getUi().alert(`✅ Deleted ${deletedCount} scheduled triggers`);
    _logInfo(`Deleted ${deletedCount} scheduled triggers`);
    
  } catch (error) {
    _logError('Failed to delete scheduled triggers', error);
    SpreadsheetApp.getUi().alert('❌ Failed to delete scheduled triggers. Check logs.');
  }
}

