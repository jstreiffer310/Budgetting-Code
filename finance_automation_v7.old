// ===================== SYSTEM DIAGNOSTICS & UTILITIES =====================

function runSystemDiagnostics() {
  try {
    const ss = _ss();
    const diagnostics = [];
    
    // Check sheet integrity
    Object.values(SHEET_NAMES).forEach(sheetName => {
      const sheet = ss.getSheetByName(sheetName);
      if (!sheet) {
        diagnostics.push(`❌ Missing sheet: ${sheetName}`);
      } else {
        diagnostics.push(`✅ Found sheet: ${sheetName} (${sheet.getLastRow()} rows)`);
      }
    });
    
    // Check for duplicate transactions
    const mainSheet = ss.getSheetByName(SHEET_NAMES.MAIN);
    if (mainSheet && mainSheet.getLastRow() > 2) {
      const data = mainSheet.getRange(2, 1, mainSheet.getLastRow() - 1, 7).getValues();
      const seen = new Set();
      let duplicates = 0;
      
      data.forEach((row, index) => {
        const key = `${new Date(row[0]).toDateString()}|${parseFloat(row[1] || 0).toFixed(2)}|${row[2]}|${row[3]}`;
        if (seen.has(key)) {
          duplicates++;
        } else {
          seen.add(key);
        }
      });
      
      if (duplicates > 0) {
        diagnostics.push(`⚠️ Found ${duplicates} potential duplicate transactions`);
      } else {
        diagnostics.push(`✅ No duplicate transactions found`);
      }
    }
    
    // Check account balance consistency
    const accountsSheet = ss.getSheetByName(SHEET_NAMES.ACCOUNTS);
    if (accountsSheet && accountsSheet.getLastRow() > 1) {
      const accountData = accountsSheet.getRange(2, 1, accountsSheet.getLastRow() - 1, 3).getValues();
      const oneWeekAgo = new Date(Date.now() - 7 * 24 * 60 * 60 * 1000);
      let staleAccounts = 0;
      
      accountData.forEach(row => {
        const lastUpdated = row[2] ? new Date(row[2]) : null;
        if (!lastUpdated || lastUpdated < oneWeekAgo) {
          staleAccounts++;
        }
      });
      
      if (staleAccounts > 0) {
        diagnostics.push(`⚠️ ${staleAccounts} accounts haven't been updated in over a week`);
      } else {
        diagnostics.push(`✅ All accounts have recent updates`);
      }
    }
    
    // Check staging queue
    const stagingSheet = ss.getSheetByName(SHEET_NAMES.STAGING);
    if (stagingSheet && stagingSheet.getLastRow() > 1) {
      const stagingCount = stagingSheet.getLastRow() - 1;
      diagnostics.push(`ℹ️ ${stagingCount} transactions in staging queue`);
    } else {
      diagnostics.push(`✅ Staging queue is empty`);
    }
    
    const report = `System Diagnostics Report\n${'='.repeat(30)}\n\n${diagnostics.join('\n')}\n\nGenerated: ${new Date().toLocaleString()}`;
    
    SpreadsheetApp.getUi().alert(report);
    _logInfo('System diagnostics completed', { diagnosticsCount: diagnostics.length });
    
  } catch (error) {
    _logError('Failed to run system diagnostics', error);
    SpreadsheetApp.getUi().alert('❌ System diagnostics failed. Check logs.');
  }
}

