// ===================== ENHANCED PRICE FETCHING WITH CAD CONVERSION =====================

function _getExchangeRates() {
  try {
    // Get USD to CAD exchange rate
    const response = UrlFetchApp.fetch('https://api.exchangerate-api.com/v4/latest/USD', {
      muteHttpExceptions: true
    });
    
    if (response.getResponseCode() === 200) {
      const data = JSON.parse(response.getContentText());
      return {
        USDCAD: data.rates.CAD || 1.35, // Fallback rate
        success: true
      };
    }
    
    // Fallback rates if API fails
    return {
      USDCAD: 1.35, // Approximate USD to CAD rate
      success: false
    };
    
  } catch (error) {
    console.error('Exchange rate fetch failed:', error);
    return {
      USDCAD: 1.35, // Fallback rate
      success: false
    };
  }
}

function _convertToCAD(price, fromCurrency = 'USD') {
  if (fromCurrency === 'CAD' || !price || price === 0) {
    return price;
  }
  
  const rates = _getExchangeRates();
  
  switch (fromCurrency.toUpperCase()) {
    case 'USD':
      return price * rates.USDCAD;
    default:
      _logWarning(`Unknown currency conversion: ${fromCurrency} to CAD`);
      return price; // Return as-is if we don't know the currency
  }
}

function _fetchPriceWithFallbacks(ticker) {
  const methods = [
    () => _fetchWithGoogleFinance(ticker),
    () => _fetchWithYahooFinance(ticker),
    () => _fetchWithCoinGecko(ticker),
    () => _fetchWithAlternativeAPI(ticker)
  ];
  
  for (let i = 0; i < methods.length; i++) {
    try {
      console.log(`Trying method ${i + 1} for ${ticker}...`);
      const result = methods[i]();
      
      if (result && result.price > 0) {
        console.log(`Success with method ${i + 1}: ${ticker} = ${result.price} ${result.currency}`);
        
        // Convert to CAD
        const cadPrice = _convertToCAD(result.price, result.currency);
        
        return {
          price: cadPrice,
          currency: 'CAD',
          source: result.source,
          originalPrice: result.price,
          originalCurrency: result.currency
        };
      }
      
    } catch (error) {
      console.error(`Method ${i + 1} failed for ${ticker}:`, error);
    }
    
    // Small delay between attempts
    if (i < methods.length - 1) {
      Utilities.sleep(CONFIG.PRICE_FETCH_DELAY);
    }
  }
  
  console.error(`All price fetch methods failed for ${ticker}`);
  return null;
}

function _fetchWithGoogleFinance(ticker) {
  const tickerUpper = ticker.toUpperCase();
  
  // Canadian stocks
  if (tickerUpper.includes('-TSE') || tickerUpper.endsWith('.TO')) {
    const symbol = tickerUpper.replace('-TSE', '').replace('.TO', '');
    
    try {
      // Try direct CAD pricing first
      const cadFormula = `=GOOGLEFINANCE("TSE:${symbol}","price")`;
      const tempSheet = SpreadsheetApp.getActiveSpreadsheet().getActiveSheet();
      const tempCell = tempSheet.getRange('ZZ1'); // Use a cell that won't interfere
      
      tempCell.setFormula(cadFormula);
      Utilities.sleep(500);
      
      const value = tempCell.getValue();
      tempCell.clear();
      
      if (typeof value === 'number' && value > 0) {
        return {
          price: value,
          currency: 'CAD',
          source: 'GOOGLEFINANCE (TSE)'
        };
      }
    } catch (error) {
      console.error(`GoogleFinance TSE failed for ${ticker}:`, error);
    }
  }
  
  // US stocks
  else if (/^[A-Z]{1,5}$/.test(tickerUpper)) {
    try {
      const usdFormula = `=GOOGLEFINANCE("${tickerUpper}","price")`;
      const tempSheet = SpreadsheetApp.getActiveSpreadsheet().getActiveSheet();
      const tempCell = tempSheet.getRange('ZZ1');
      
      tempCell.setFormula(usdFormula);
      Utilities.sleep(500);
      
      const value = tempCell.getValue();
      tempCell.clear();
      
      if (typeof value === 'number' && value > 0) {
        return {
          price: value,
          currency: 'USD',
          source: 'GOOGLEFINANCE (US)'
        };
      }
    } catch (error) {
      console.error(`GoogleFinance US failed for ${ticker}:`, error);
    }
  }
  
  // Some crypto pairs
  else if (['BTC-CAD', 'ETH-CAD', 'BTC-USD', 'ETH-USD'].includes(tickerUpper)) {
    try {
      const cryptoFormula = `=GOOGLEFINANCE("${tickerUpper}","price")`;
      const tempSheet = SpreadsheetApp.getActiveSpreadsheet().getActiveSheet();
      const tempCell = tempSheet.getRange('ZZ1');
      
      tempCell.setFormula(cryptoFormula);
      Utilities.sleep(500);
      
      const value = tempCell.getValue();
      tempCell.clear();
      
      if (typeof value === 'number' && value > 0) {
        const currency = tickerUpper.includes('-CAD') ? 'CAD' : 'USD';
        return {
          price: value,
          currency: currency,
          source: 'GOOGLEFINANCE (Crypto)'
        };
      }
    } catch (error) {
      console.error(`GoogleFinance crypto failed for ${ticker}:`, error);
    }
  }
  
  return null;
}

function _fetchWithYahooFinance(ticker) {
  try {
    let yahooTicker = ticker.toUpperCase();
    
    // Convert ticker formats for Yahoo Finance
    if (yahooTicker.includes('-TSE')) {
      yahooTicker = yahooTicker.replace('-TSE', '.TO');
    } else if (yahooTicker.includes('-USD')) {
      yahooTicker = yahooTicker.replace('-USD', '-USD');
    } else if (yahooTicker.includes('-CAD')) {
      yahooTicker = yahooTicker.replace('-CAD', '-CAD');
    }
    
    const url = `https://query1.finance.yahoo.com/v8/finance/chart/${yahooTicker}`;
    
    const response = UrlFetchApp.fetch(url, {
      method: 'GET',
      headers: {
        'User-Agent': 'Mozilla/5.0 (compatible; Finance-Script/1.0)'
      },
      muteHttpExceptions: true
    });
    
    if (response.getResponseCode() !== 200) {
      return null;
    }
    
    const data = JSON.parse(response.getContentText());
    
    if (data.chart && 
        data.chart.result && 
        data.chart.result[0] && 
        data.chart.result[0].meta && 
        data.chart.result[0].meta.regularMarketPrice) {
      
      const price = parseFloat(data.chart.result[0].meta.regularMarketPrice);
      const currency = data.chart.result[0].meta.currency || 'USD';
      
      return {
        price: price,
        currency: currency,
        source: 'Yahoo Finance'
      };
    }
    
  } catch (error) {
    console.error(`Yahoo Finance failed for ${ticker}:`, error);
  }
  
  return null;
}

function _fetchWithCoinGecko(ticker) {
  try {
    const tickerUpper = ticker.toUpperCase();
    
    // Only handle crypto tickers
    if (!tickerUpper.includes('-USD') && !tickerUpper.includes('-CAD')) {
      return null;
    }
    
    const [crypto, currency] = tickerUpper.split('-');
    
    // Mapping of crypto symbols to CoinGecko IDs
    const cryptoMap = {
      'BTC': 'bitcoin',
      'ETH': 'ethereum',
      'DOT': 'polkadot',
      'SOL': 'solana',
      'SHIB': 'shiba-inu',
      'ADA': 'cardano',
      'MATIC': 'matic-network',
      'DOGE': 'dogecoin',
      'LTC': 'litecoin',
      'LINK': 'chainlink',
      'UNI': 'uniswap',
      'AVAX': 'avalanche-2'
    };
    
    const cryptoId = cryptoMap[crypto];
    if (!cryptoId) {
      return null;
    }
    
    const targetCurrency = currency.toLowerCase();
    const url = `https://api.coingecko.com/api/v3/simple/price?ids=${cryptoId}&vs_currencies=${targetCurrency}`;
    
    const response = UrlFetchApp.fetch(url, {
      method: 'GET',
      headers: {
        'Accept': 'application/json',
        'User-Agent': 'Finance-Automation-Script'
      },
      muteHttpExceptions: true
    });
    
    if (response.getResponseCode() !== 200) {
      return null;
    }
    
    const data = JSON.parse(response.getContentText());
    
    if (data[cryptoId] && data[cryptoId][targetCurrency]) {
      const price = parseFloat(data[cryptoId][targetCurrency]);
      
      return {
        price: price,
        currency: currency,
        source: 'CoinGecko'
      };
    }
    
  } catch (error) {
    console.error(`CoinGecko failed for ${ticker}:`, error);
  }
  
  return null;
}

