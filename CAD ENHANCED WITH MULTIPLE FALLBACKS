    }
    
    const data = holdingsSheet.getRange(2, 1, holdingsSheet.getLastRow() - 1, Object.keys(COLUMNS.HOLDINGS).length).getValues();
    let refreshedCount = 0;
    let errorCount = 0;
    
    for (let i = 0; i < data.length; i++) {
      const row = i + 2;
      const ticker = _normalize(data[i][COLUMNS.HOLDINGS.TICKER - 1]);
      const shares = parseFloat(data[i][COLUMNS.HOLDINGS.SHARES - 1] || 0);
      
      if (!ticker || shares === 0) continue;
      
      console.log(`Manual refresh for: ${ticker}`);
      
      try {
        const priceResult = _fetchPriceWithFallbacks(ticker);
        
        if (priceResult && priceResult.price > 0) {
          const unitPriceCAD = priceResult.price;
          const totalValueCAD = unitPriceCAD * shares;
          
          holdingsSheet.getRange(row, COLUMNS.HOLDINGS.UNIT_PRICE_CAD).setValue(unitPriceCAD);
          holdingsSheet.getRange(row, COLUMNS.HOLDINGS.TOTAL_VALUE_CAD).setValue(totalValueCAD);
          holdingsSheet.getRange(row, COLUMNS.HOLDINGS.LAST_UPDATED).setValue(new Date());
          
          // Format cells
          holdingsSheet.getRange(row, COLUMNS.HOLDINGS.UNIT_PRICE_CAD).setNumberFormat('$#,##0.00####');
          holdingsSheet.getRange(row, COLUMNS.HOLDINGS.TOTAL_VALUE_CAD).setNumberFormat('$#,##0.00');
          
          refreshedCount++;
          console.log(`✅ ${ticker}: $${unitPriceCAD.toFixed(4)} CAD (${priceResult.source})`);
        } else {
          holdingsSheet.getRange(row, COLUMNS.HOLDINGS.UNIT_PRICE_CAD).setValue('ERROR');
          errorCount++;
          console.log(`❌ ${ticker}: Failed to fetch price`);
        }
        
      } catch (error) {
        holdingsSheet.getRange(row, COLUMNS.HOLDINGS.UNIT_PRICE_CAD).setValue('ERROR');
        errorCount++;
        console.log(`❌ ${ticker}: ${error.message}`);
      }
      
      Utilities.sleep(CONFIG.PRICE_FETCH_DELAY);
    }
    
    const message = `Manual price refresh completed!\n\n` +
                   `✅ Successfully refreshed: ${refreshedCount}\n` +
                   `❌ Errors: ${errorCount}\n\n` +
                   `All prices are displayed in CAD.`;
    
    SpreadsheetApp.getUi().alert(message);
    _logInfo('Manual price refresh completed', { refreshed: refreshedCount, errors: errorCount });
    
  } catch (error) {
    _logError('Manual price refresh failed', error);
    SpreadsheetApp.getUi().alert('❌ Manual price refresh failed. Check logs.');
  }
}

