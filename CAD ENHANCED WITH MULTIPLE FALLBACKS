// ===================== HOLDINGS MANAGEMENT WITH CAD CONVERSION =====================

function _updateHoldingsQuantity(accountName, ticker, sharesDelta) {
  try {
    const ss = _ss();
    const holdingsSheet = ss.getSheetByName(SHEET_NAMES.HOLDINGS);
    
    if (!holdingsSheet) {
      _logWarning('Holdings sheet not found');
      return;
    }
    
    const data = holdingsSheet.getDataRange().getValues();
    let found = false;
    
    // Look for existing holding
    for (let i = 1; i < data.length; i++) {
      if (_lc(data[i][COLUMNS.HOLDINGS.ACCOUNT - 1]) === _lc(accountName) && 
          _lc(data[i][COLUMNS.HOLDINGS.TICKER - 1]) === _lc(ticker)) {
        
        const currentShares = parseFloat(data[i][COLUMNS.HOLDINGS.SHARES - 1] || 0);
        const newShares = currentShares + sharesDelta;
        
        holdingsSheet.getRange(i + 1, COLUMNS.HOLDINGS.SHARES).setValue(newShares);
        holdingsSheet.getRange(i + 1, COLUMNS.HOLDINGS.LAST_UPDATED).setValue(new Date());
        
        _logInfo(`Updated ${ticker} in ${accountName}: ${currentShares} → ${newShares} shares`);
        found = true;
        break;
      }
    }
    
    // Add new holding if not found
    if (!found) {
      holdingsSheet.appendRow([
        accountName,
        ticker,
        sharesDelta,
        0, // Unit price will be updated by price fetching
        0, // Total value will be calculated
        new Date()
      ]);
      _logInfo(`Added new holding: ${sharesDelta} shares of ${ticker} in ${accountName}`);
    }
    
  } catch (error) {
    _logError('Failed to update holdings quantity', error);
  }
}

function updateHoldingsAndBalances() {
  try {
    _logInfo('Starting holdings and balances update with CAD conversion...');
    
    const ss = _ss();
    const holdingsSheet = ss.getSheetByName(SHEET_NAMES.HOLDINGS);
    const accountsSheet = ss.getSheetByName(SHEET_NAMES.ACCOUNTS);
    
    if (!holdingsSheet || holdingsSheet.getLastRow() < 2) {
      _logInfo('Holdings sheet is empty, skipping update');
      return;
    }
    
    const data = holdingsSheet.getRange(2, 1, holdingsSheet.getLastRow() - 1, Object.keys(COLUMNS.HOLDINGS).length).getValues();
    const accountTotals = {};
    let updatedCount = 0;
    let errorCount = 0;
    
    // Process each holding
    for (let i = 0; i < data.length; i++) {
      const row = i + 2; // Actual sheet row
      const account = _normalize(data[i][COLUMNS.HOLDINGS.ACCOUNT - 1]);
      const ticker = _normalize(data[i][COLUMNS.HOLDINGS.TICKER - 1]);
      const shares = parseFloat(data[i][COLUMNS.HOLDINGS.SHARES - 1] || 0);
      
      console.log(`Processing: ${ticker} in ${account}, ${shares} shares`);
      
      if (!account || !ticker || shares === 0) {
        console.log(`Skipping invalid holding: ${ticker}`);
        continue;
      }
      
      try {
        // Fetch price with multiple fallbacks
        const priceResult = _fetchPriceWithFallbacks(ticker);
        
        if (priceResult && priceResult.price > 0) {
          const unitPriceCAD = priceResult.price;
          const totalValueCAD = unitPriceCAD * shares;
          
          // Update the holding
          holdingsSheet.getRange(row, COLUMNS.HOLDINGS.UNIT_PRICE_CAD).setValue(unitPriceCAD);
          holdingsSheet.getRange(row, COLUMNS.HOLDINGS.TOTAL_VALUE_CAD).setValue(totalValueCAD);
          holdingsSheet.getRange(row, COLUMNS.HOLDINGS.LAST_UPDATED).setValue(new Date());
          
          // Format cells
          holdingsSheet.getRange(row, COLUMNS.HOLDINGS.UNIT_PRICE_CAD).setNumberFormat('$#,##0.00####');
          holdingsSheet.getRange(row, COLUMNS.HOLDINGS.TOTAL_VALUE_CAD).setNumberFormat('$#,##0.00');
          
          // Track account totals
          accountTotals[account] = (accountTotals[account] || 0) + totalValueCAD;
          updatedCount++;
          
          _logInfo(`Updated ${ticker}: ${shares} × $${unitPriceCAD.toFixed(4)} CAD = $${totalValueCAD.toFixed(2)} CAD`, {
            source: priceResult.source,
            originalPrice: priceResult.originalPrice,
            originalCurrency: priceResult.originalCurrency
          });
          
        } else {
          // Set error indicator
          holdingsSheet.getRange(row, COLUMNS.HOLDINGS.UNIT_PRICE_CAD).setValue('ERROR');
          holdingsSheet.getRange(row, COLUMNS.HOLDINGS.LAST_UPDATED).setValue(new Date());
          errorCount++;
          
          _logWarning(`Failed to fetch price for ${ticker}`);
        }
        
      } catch (error) {
        _logError(`Error processing ${ticker}`, error);
        
        holdingsSheet.getRange(row, COLUMNS.HOLDINGS.UNIT_PRICE_CAD).setValue('ERROR');
        holdingsSheet.getRange(row, COLUMNS.HOLDINGS.LAST_UPDATED).setValue(new Date());
        errorCount++;
      }
      
      // Rate limiting
      Utilities.sleep(CONFIG.PRICE_FETCH_DELAY);
    }
    
    // Update account balances for investment accounts
    for (const [accountName, totalValue] of Object.entries(accountTotals)) {
      const accountRow = _findAccountRow(accountsSheet, accountName);
      if (accountRow > 0) {
        accountsSheet.getRange(accountRow, COLUMNS.ACCOUNTS.BALANCE).setValue(totalValue);
        accountsSheet.getRange(accountRow, COLUMNS.ACCOUNTS.BALANCE).setNumberFormat('$#,##0.00');
        accountsSheet.getRange(accountRow, COLUMNS.ACCOUNTS.LAST_UPDATED).setValue(new Date());
        
        _logInfo(`Updated ${accountName} balance: $${totalValue.toFixed(2)} CAD`);
      }
    }
    
    const message = `Holdings update completed!\n\n` +
                   `Successfully updated: ${updatedCount}\n` +
                   `Errors: ${errorCount}\n` +
                   `Total portfolio value: $${Object.values(accountTotals).reduce((a, b) => a + b, 0).toFixed(2)} CAD`;
    
    console.log(message);
    SpreadsheetApp.getUi().alert(message);
    
    _logInfo(`Holdings update completed`, {
      updated: updatedCount,
      errors: errorCount,
      totalValueCAD: Object.values(accountTotals).reduce((a, b) => a + b, 0)
    });
    
  } catch (error) {
    _logError('Failed to update holdings and balances', error);
    SpreadsheetApp.getUi().alert('❌ Holdings update failed. Check execution logs for details.');
  }
}

