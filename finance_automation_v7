      // Calculate value
      const value = Number(price || 0) * Number(shares || 0);
      holdingsSheet.getRange(row, COLUMNS.HOLDINGS.TOTAL_VALUE_CAD).setValue(value);
      holdingsSheet.getRange(row, COLUMNS.HOLDINGS.TOTAL_VALUE_CAD).setNumberFormat('$#,##0.00');
      holdingsSheet.getRange(row, COLUMNS.HOLDINGS.LAST_UPDATED).setValue(new Date());

      // Accumulate totals
  if (value > 0 && account) accountTotals[account] = (accountTotals[account] || 0) + value;

      // Log source
      _logInfo(`Updated ${ticker}: ${price} CAD via ${source}`);
    }

    // Update account balances
    for (const [accountName, totalValue] of Object.entries(accountTotals)) {
      const accountRow = _findAccountRow(accountsSheet, accountName);
      if (accountRow > 0) {
        accountsSheet.getRange(accountRow, 2).setValue(totalValue);
        accountsSheet.getRange(accountRow, 2).setNumberFormat('$#,##0.00');
        accountsSheet.getRange(accountRow, 3).setValue(new Date());
      }
    }

    SpreadsheetApp.getUi().alert('✅ Holdings and balances updated in CAD!');
  } catch (error) {
    _logError('Failed to update holdings and balances', error);
    SpreadsheetApp.getUi().alert('❌ Failed to update holdings and balances. See logs.');
  }
}

