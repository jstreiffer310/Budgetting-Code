// Lowercase and normalize string utility
function _lc(s) {
  return (s || '').toString().trim().toLowerCase();
}
// Generic normalize: trim, collapse whitespace, strip diacritics
function _normalize(s) {
  if (s === null || s === undefined) return '';
  try {
    // Convert to string, normalize unicode, remove diacritics, collapse spaces
    return String(s)
      .normalize('NFKD')
      .replace(/[\u0300-\u036f]/g, '')
      .replace(/\u00A0/g, ' ')
      .replace(/\s+/g, ' ')
      .trim();
  } catch (e) {
    return String(s).trim();
  }
}

// Robust numeric parser: strip currency/commas/spaces and parse to Number
function _toNumber(v) {
  if (v === null || v === undefined) return 0;
  if (typeof v === 'number') return v;
  try {
    const cleaned = String(v).replace(/[^0-9.\-]+/g, '');
    const n = Number(cleaned);
    return isNaN(n) ? 0 : n;
  } catch (e) {
    return 0;
  }
}
